# ------------------------------------------------------------------
# CTF Learning Tree — .gitignore (Go + Node/Vite)
# ------------------------------------------------------------------

# --- Go -----------------------------------------------------------
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html

# --- Node / Vite --------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Данные приложения --------------------------------------------
# Профили прогресса читателей — персональные данные, не коммитим.
/data/
*.tmp
*.log

# --- Окружение ----------------------------------------------------
.env
.env.local
.env.*.local

# --- Редакторы / ОС -----------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- MCP / отладка браузера ---------------------------------------
.playwright-mcp/

# --- Скриншоты в корне репозитория --------------------------------
/tree-*.png
/stats-*.png
/*.png

# --- Прочие артефакты ---------------------------------------------
/__pycache__/
**/__pycache__/
*.pyc

# --- Go-утилиты, собранные локально в корне репозитория ------------
# `go build -o labvalidate ./tools/labvalidate` кладёт бинарь в корень.
/labvalidate
