{
  "id": "reversing-libraries-re",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/answer.txt",
    "contains": "strcmp"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: список импортов динамического символа\n\nДинамическая таблица символов (`.dynsym`) перечисляет, какие внешние функции\nпрограмма использует. `nm -D` печатает их с пометкой `U` (undefined).\n\n1. `nm -D crackme`\n2. `readelf --dyn-syms crackme`\n\nЗапиши **имя функции, которую программа использует для сравнения строк**\n(её же импортирует) в `answer.txt` и набери `check`.\n"
    },
    {
      "path": "/home/student/task/crackme",
      "b64": "",
      "mode": "755"
    }
  ],
  "tools": {
    "nm": {
      "help": "nm <файл> — таблица символов (вывод реального nm)",
      "cases": [
        {
          "match": "\\S",
          "example": "nm <файл>",
          "output": "                 w _ITM_deregisterTMCloneTable\n                 w _ITM_registerTMCloneTable\n                 w __cxa_finalize@GLIBC_2.2.5\n                 w __gmon_start__\n                 U __libc_start_main@GLIBC_2.34\n                 U printf@GLIBC_2.2.5\n                 U puts@GLIBC_2.2.5\n                 U strcmp@GLIBC_2.2.5\n"
        }
      ],
      "fallback": "                 w _ITM_deregisterTMCloneTable\n                 w _ITM_registerTMCloneTable\n                 w __cxa_finalize@GLIBC_2.2.5\n                 w __gmon_start__\n                 U __libc_start_main@GLIBC_2.34\n                 U printf@GLIBC_2.2.5\n                 U puts@GLIBC_2.2.5\n                 U strcmp@GLIBC_2.2.5\n"
    },
    "readelf": {
      "help": "readelf --dyn-syms <файл> — динамические символы",
      "cases": [
        {
          "match": "dyn-syms",
          "example": "readelf --dyn-syms crackme",
          "output": "\nSymbol table '.dynsym' contains 9 entries:\n   Num:    Value          Size Type    Bind   Vis      Ndx Name\n     0: 0000000000000000     0 NOTYPE  LOCAL  DEFAULT  UND \n     1: 0000000000000000     0 FUNC    GLOBAL DEFAULT  UND _[...]@GLIBC_2.34 (2)\n     2: 0000000000000000     0 NOTYPE  WEAK   DEFAULT  UND _ITM_deregisterT[...]\n     3: 0000000000000000     0 FUNC    GLOBAL DEFAULT  UND puts@GLIBC_2.2.5 (3)\n     4: 0000000000000000     0 FUNC    GLOBAL DEFAULT  UND [...]@GLIBC_2.2.5 (3)\n     5: 0000000000000000     0 FUNC    GLOBAL DEFAULT  UND [...]@GLIBC_2.2.5 (3)\n     6: 0000000000000000     0 NOTYPE  WEAK   DEFAULT  UND __gmon_start__\n     7: 0000000000000000     0 NOTYPE  WEAK   DEFAULT  UND _ITM_registerTMC[...]\n     8: 0000000000000000     0 FUNC    WEAK   DEFAULT  UND [...]@GLIBC_2.2.5 (3)\n"
        }
      ],
      "fallback": "\nSymbol table '.dynsym' contains 9 entries:\n   Num:    Value          Size Type    Bind   Vis      Ndx Name\n     0: 0000000000000000     0 NOTYPE  LOCAL  DEFAULT  UND \n     1: 0000000000000000     0 FUNC    GLOBAL DEFAULT  UND _[...]@GLIBC_2.34 (2)\n     2: 0000000000000000     0 NOTYPE  WEAK   DEFAULT  UND _ITM_deregisterT[...]\n     3: 0000000000000000     0 FUNC    GLOBAL DEFAULT  UND puts@GLIBC_2.2.5 (3)\n     4: 0000000000000000     0 FUNC    GLOBAL DEFAULT  UND [...]@GLIBC_2.2.5 (3)\n     5: 0000000000000000     0 FUNC    GLOBAL DEFAULT  UND [...]@GLIBC_2.2.5 (3)\n     6: 0000000000000000     0 NOTYPE  WEAK   DEFAULT  UND __gmon_start__\n     7: 0000000000000000     0 NOTYPE  WEAK   DEFAULT  UND _ITM_registerTMC[...]\n     8: 0000000000000000     0 FUNC    WEAK   DEFAULT  UND [...]@GLIBC_2.2.5 (3)\n"
    }
  }
}
