{
  "id": "mobile-keystore",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{k3yst0r3_4l14s_r3v34l5}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: посмотреть содержимое keystore\n\nВ каталоге лежит `app.keystore` (настоящий PKCS12) и файл `keystore.properties`\nс паролем. Учётная запись (alias) подписана сертификатом, в CN которого спрятан\nфлаг. Достань его и запиши в `found.txt`.\n\nИнструмент `keytool` эмулируется (вывод реального keytool).\nПолезно: `cat keystore.properties`, затем `keytool -list -v -keystore app.keystore -storepass <пароль>`.\n"
    },
    {
      "path": "/home/student/task/app.keystore",
      "b64": "",
      "mode": "644"
    },
    {
      "path": "/home/student/task/keystore.properties",
      "text": "storeFile=app.keystore\nstorePassword=changeit\nkeyAlias=release\n"
    }
  ],
  "tools": {
    "keytool": {
      "help": "keytool -list [-v] -keystore <файл> -storepass <пароль> — эмуляция (вывод реального keytool)",
      "cases": [
        {
          "match": "-list\\s+-v",
          "example": "-list -v -keystore app.keystore -storepass changeit",
          "output": "Keystore type: PKCS12\nKeystore provider: SUN\n\nYour keystore contains 1 entry\n\nAlias name: release\nCreation date: Oct 13, 2026\nEntry type: PrivateKeyEntry\nCertificate chain length: 1\nCertificate[1]:\nOwner: CN=nto{k3yst0r3_4l14s_r3v34l5}, OU=mobile, O=vanta\nIssuer: CN=nto{k3yst0r3_4l14s_r3v34l5}, OU=mobile, O=vanta\nSerial number: 5f1c0a2b\nValid from: Tue Oct 13 12:21:05 MSK 2026 until: Fri Oct 10 12:21:05 MSK 2036\n"
        },
        {
          "match": "-list",
          "example": "-list -keystore app.keystore -storepass changeit",
          "output": "Keystore type: PKCS12\nKeystore provider: SUN\n\nYour keystore contains 1 entry\n\nrelease, Oct 13, 2026, PrivateKeyEntry, \nCertificate fingerprint (SHA-256): 11:E5:25:CA:5C:31:36:1B:A3:31:0F:64:EA:95:6E:0F:B7:93:A4:F2:15:B9:48:5E:19:45:15:40:21:3D:0B:23\n"
        }
      ]
    }
  }
}
