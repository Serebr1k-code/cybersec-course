{
  "id": "stego-grayscale",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{gr4ysc4l3_lsb}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: LSB в grayscale PNG\n\n`gray.png` — grayscale-изображение с данными в младших битах яркости. Извлеки сообщение.\n\n1. `python3 graylsb.py` — чтение LSB яркости.\n2. Запиши флаг в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/gray.png",
      "b64": ""
    },
    {
      "path": "/home/student/task/graylsb.py",
      "text": "print('nto{gr4ysc4l3_lsb}')\n"
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция, вывод реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        },
        {
          "match": "graylsb\\.py",
          "example": "python3 graylsb.py",
          "output": "nto{gr4ysc4l3_lsb}\n"
        }
      ]
    }
  }
}
