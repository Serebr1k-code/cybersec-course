    {
      "path": "/home/student/task/keygenme",
      "b64": "",
      "mode": "755"
    },
    {
      "path": "/home/student/task/solve.py",
      "text": "from z3 import *\ntgt = [90, 19, 77, 65, 71, 17, 67]\nk = [BitVec('k%d'%i, 8) for i in range(len(tgt))]\ns = Solver()\nfor i in range(len(tgt)):\n    s.add(k[i] ^ 0x20 == tgt[i])\n    s.add(k[i] >= 0x20, k[i] <= 0x7e)\ns.check()\nm = s.model()\nprint('key =', bytes([m[x].as_long() for x in k]).decode())\n"
    }
  ],
