{
  "id": "osint-deepfake",
  "hostname": "lab",
  "workdir": "/home/student/task",
  "expect": {
    "file": "/home/student/task/answer.txt",
    "contains": "nto{synth3t1c_m3d14_c0nf1rm3d}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Практика: фото сгенерировано нейросетью?\n\nФайл `suspect.jpg` из удалённого поста. Проверь метаданные и прогони через детектор.\n\n1. `exiftool -a -u -g1 suspect.jpg` — нет ли `Make`/`Camera Model Name`?\n2. Обрати внимание на ровный размер 1024x1024.\n3. Детектор: `curl -s -X POST \"https://api.example-detector.com/v1/detect\" -F \"file=@suspect.jpg\" > det.json`\n4. `jq '{verdict,confidence}' det.json`\n5. Маркер `nto{...}` в отчёте детектора — запиши в `answer.txt`, набери `check`.\n"
    },
    {
      "path": "/home/student/task/suspect.jpg",
      "b64": "",
      "mode": "644"
    }
  ],
  "tools": {
    "exiftool": {
      "help": "exiftool [-a -u -g1] <файл> — метаданные (эмуляция)",
      "cases": [
        {
          "match": "suspect\\.jpg",
          "example": "-a -u -g1 suspect.jpg",
          "output": "======== suspect.jpg\nExifTool Version Number         : 12.76\nFile Name                       : suspect.jpg\nFile Type                       : JPEG\nImage Width                     : 1024\nImage Height                    : 1024\nEncoding Process                : Baseline DCT, Huffman coding\n    1 image files read\n"
        }
      ],
      "fallback": "exiftool: в этой лабе есть только suspect.jpg.\n"
    },
    "curl": {
      "help": "curl [-s] -X POST <URL> -F file=@… — детектор синтетики (эмуляция)",
      "cases": [
        {
          "match": "api\\.example-detector\\.com",
          "example": "curl -s -X POST https://api.example-detector.com/v1/detect -F file=@suspect.jpg",
          "output": "{\"verdict\": \"likely_synthetic\", \"confidence\": 0.87,\n \"signals\": [\"no_exif_camera\", \"square_1024\", \"fft_grid\", \"smooth_skin\"],\n \"report\": \"nto{synth3t1c_m3d14_c0nf1rm3d}\"}\n"
        }
      ],
      "fallback": "curl: в этой лабе доступен только api.example-detector.com/v1/detect.\n"
    },
    "jq": {
      "help": "jq [-r] <фильтр> <файл> — разбор JSON (эмуляция)",
      "cases": [
        {
          "match": "verdict|confidence|report",
          "example": "jq '{verdict,confidence}' det.json",
          "output": "{\n  \"verdict\": \"likely_synthetic\",\n  \"confidence\": 0.87\n}\n"
        }
      ],
      "fallback": "jq: в этой лабе поддержан фильтр по verdict/confidence.\n"
    }
  }
}
