{
  "id": "stego-media-basics",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{lsb_b4s1cs_1mg_4ud10}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: LSB в изображении и аудио\n\nДва носителя одного метода — младший бит:\n- `cover.png` — сообщение в LSB каналов RGB (`python3 extract.py`).\n- `tone.wav` — сообщение в LSB сэмплов (`python3 audio.py`).\n\nДостань флаг из изображения и запиши в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/notes.txt",
      "text": "Порядок обхода каналов критичен: R,G,B построчно. В аудио — по сэмплам подряд.\n"
    },
    {
      "path": "/home/student/task/cover.png",
      "b64": "",
      "mode": "644"
    },
    {
      "path": "/home/student/task/tone.wav",
      "b64": "",
      "mode": "644"
    },
    {
      "path": "/home/student/task/extract.py",
      "text": "import re\nfrom PIL import Image\nimg = Image.open('cover.png').convert('RGB')\nbits = ''\nfor y in range(img.height):\n    for x in range(img.width):\n        for c in img.getpixel((x, y)):\n            bits += str(c & 1)\ndata = bytes(int(bits[i:i+8], 2) for i in range(0, len(bits)//8*8, 8))\nm = re.search(rb'nto\\{[^}]*\\}', data)\nprint('recovered LSB message:')\nprint(m.group().decode() if m else '(nothing)')\n"
    },
    {
      "path": "/home/student/task/audio.py",
      "text": "import wave, struct, re\nw = wave.open('tone.wav','rb')\nn = w.getnframes()\nsamples = struct.unpack('<%dh' % n, w.readframes(n))\nbits = ''.join(str(s & 1) for s in samples)\ndata = bytes(int(bits[i:i+8], 2) for i in range(0, len(bits)//8*8, 8))\nm = re.search(rb'nto\\{[^}]*\\}', data)\nprint('WAV samples:', n)\nprint('recovered from sample LSBs:')\nprint(m.group().decode() if m else '(nothing)')\n"
    }
  ],
  "tools": {
