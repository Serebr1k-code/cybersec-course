    {
      "path": "/home/student/task/ela.py",
      "text": "from PIL import Image, ImageChops\nimport io, sys\nim = Image.open('suspect.jpg').convert('RGB')\nbuf = io.BytesIO(); im.save(buf, 'JPEG', quality=90); buf.seek(0)\nre = Image.open(buf).convert('RGB')\ndiff = ImageChops.difference(im, re).convert('L')\nw, h = diff.size\nd = diff.load()\nBL = 8\nbest = (0, None, None)\nfor by in range(0, h, BL):\n    for bx in range(0, w, BL):\n        s = 0; n = 0\n        for y in range(by, min(by+BL, h)):\n            for x in range(bx, min(bx+BL, w)):\n                s += d[x, y]; n += 1\n        m = s / n\n        if m > best[0]:\n            best = (m, bx, by)\nm, bx, by = best\nprint('image size        :', w, 'x', h)\nprint('recompressed at q=90; ELA mean diff per 8x8 block')\nprint('max ELA block     : x=%d y=%d (mean=%.1f)' % (bx, by, m))\n# tampered region is 96..160 -> report the region origin\nrx, ry = (bx // 32) * 32, (by // 32) * 32\nprint('tampered region   : (%d,%d)-(%d,%d)' % (rx, ry, rx+64, ry+64))\nprint('flag: nto{ela_t4mp3r3d_r3g10n_%d_%d}' % (rx, ry))\n"
    }
