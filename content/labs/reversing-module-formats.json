{
  "id": "reversing-module-formats",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{mz_4rr0w_t0_pe_fl4g}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: три формата бинарников\n\nВ каталоге три файла: ELF, PE и Mach-O. Определи каждый и достань флаг из PE.\n\n1. `file prog.elf fmt.exe prog.macho` и `xxd` первых байт.\n2. `readelf --file-header prog.elf` — ELF-заголовок.\n3. `python3 pe.py fmt.exe` — разбор DOS/PE-заголовков и секции `.flag`.\n\nФлаг запиши в `found.txt` и набери `check`.\n"
    },
    {
      "path": "/home/student/task/prog.elf",
      "b64": "",
      "mode": "755"
    },
    {
      "path": "/home/student/task/fmt.exe",
      "b64": "",
      "mode": "755"
    },
    {
      "path": "/home/student/task/prog.macho",
      "b64": "",
      "mode": "755"
    },
    {
      "path": "/home/student/task/pe.py",
      "text": "import struct,sys\nd=open(sys.argv[1],'rb').read()\nassert d[:2]==b'MZ', 'not MZ'\npe=struct.unpack_from('<I',d,0x3c)[0]\nassert d[pe:pe+4]==b'PE\\x00\\x00', 'no PE sig'\nnsect=struct.unpack_from('<H',d,pe+6)[0]\noptsz=struct.unpack_from('<H',d,pe+20)[0]\nbase=pe+24+optsz\nprint('PE header at 0x%x, sections=%d' % (pe,nsect))\nfor i in range(nsect):\n    o=base+i*40\n    name=d[o:o+8].rstrip(b'\\x00').decode()\n    vs,va,rs,rp=struct.unpack_from('<IIII',d,o+8)\n    print('  %-8s VA=0x%x raw=0x%x size=0x%x' % (name,va,rp,rs))\n    if name=='.flag':\n        enc=d[rp:rp+rs].split(b'\\x00')[0]\n        print('flag =', bytes(b^0x33 for b in enc).decode())\n"
    },
    {
      "path": "/home/student/task/macho.py",
      "text": "import struct,sys\nd=open(sys.argv[1],'rb').read()\nmagic,cputype,cpusub,ftype,ncmds,sz,flags,res=struct.unpack_from('<8I',d,0)\nprint('magic=0x%08x cputype=0x%x ftype=%d ncmds=%d' % (magic,cputype,ftype,ncmds))\noff=32\nfor _ in range(ncmds):\n    cmd,cmdsize=struct.unpack_from('<II',d,off)\n    if cmd==0x19:\n        nsects=struct.unpack_from('<I',d,off+64)[0]\n        so=off+72\n        for _ in range(nsects):\n            sn=d[so:so+16].rstrip(b'\\x00').decode()\n            sg=d[so+16:so+32].rstrip(b'\\x00').decode()\n            size=struct.unpack_from('<Q',d,so+40)[0]\n            fo=struct.unpack_from('<I',d,so+48)[0]\n            print('  section %s,%s size=%d off=0x%x' % (sg,sn,size,fo))\n            if sn=='__cstring':\n                enc=d[fo:fo+size].split(b'\\x00')[0]\n                print('flag =', bytes(b^0x11 for b in enc).decode())\n    off+=cmdsize\n"
    }
  ],
  "tools": {
    "readelf": {
      "help": "readelf <опция> <файл>",
      "cases": [
        {
          "match": "file-header",
          "example": "readelf --file-header prog.elf",
          "output": "ELF Header:\n  Magic:   7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00 \n  Class:                             ELF64\n  Data:                              2's complement, little endian\n  Version:                           1 (current)\n  OS/ABI:                            UNIX - System V\n  ABI Version:                       0\n  Type:                              EXEC (Executable file)\n  Machine:                           Advanced Micro Devices X86-64\n  Version:                           0x1\n  Entry point address:               0x401020\n  Start of program headers:          64 (bytes into file)\n  Start of section headers:          14528 (bytes into file)\n  Flags:                             0x0\n  Size of this header:               64 (bytes)\n  Size of program headers:           56 (bytes)\n  Number of program headers:         14\n  Size of section headers:           64 (bytes)\n  Number of section headers:         35\n  Section header string table index: 34\n"
        }
      ]
    },
    "python3": {
      "help": "python3 <скрипт> <файл>",
      "cases": [
        {
          "match": "pe\\.py",
