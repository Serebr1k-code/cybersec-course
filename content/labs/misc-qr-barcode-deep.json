{
  "id": "misc-qr-barcode-deep",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{qr_c0d3s_4r3_d4t4}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: прочитать QR-код\n\n`qr.png` — настоящий QR-код. Внутри закодирована строка с флагом. Распознай код\nи запиши флаг в `found.txt`.\n\nИнструмент `zbarimg` эмулируется (вывод реального zbarimg).\nПолезно: `file qr.png`, `zbarimg qr.png`.\n"
    },
    {
      "path": "/home/student/task/qr.png",
      "b64": "",
      "mode": "644"
    }
  ],
  "tools": {
    "zbarimg": {
      "help": "zbarimg [-q] <изображение> — распознать штрих/QR-код (эмуляция, вывод реального zbarimg)",
      "cases": [
        {
          "match": "qr\\.png",
          "example": "qr.png",
          "output": "QR-Code:nto{qr_c0d3s_4r3_d4t4}\nscanned 1 barcode symbols from 1 images in 0.01 seconds\n"
        }
      ]
    }
  }
}
