   "path": "/home/student/task/macho.py",
   "text": "#!/usr/bin/env python3\n# Minimal Mach-O 64 reader: header, load commands, segments/sections.\nimport struct, sys\nd = open(sys.argv[1],'rb').read()\nmagic, cputype, cpusub, ftype, ncmds, szcmds, flags, res = struct.unpack_from('<8I', d, 0)\nif magic == 0xfeedfacf:\n    print('magic=0x%08x (Mach-O 64-bit, little-endian: cffaedfe)' % magic)\nelse:\n    print('magic=0x%08x (not a Mach-O 64)' % magic); sys.exit(1)\nARCH = {0x0100000c:'arm64', 0x01000007:'x86_64'}\nprint('cputype=0x%08x (%s) filetype=%d ncmds=%d sizeofcmds=%d flags=0x%x' %\n      (cputype, ARCH.get(cputype,'?'), ftype, ncmds, szcmds, flags))\noff = 32\nfor _ in range(ncmds):\n    cmd, cmdsize = struct.unpack_from('<II', d, off)\n    if cmd == 0x19:  # LC_SEGMENT_64\n        seg = d[off+8:off+24].rstrip(b'\\0').decode()\n        vmaddr, vmsize, fileoff, filesize, maxp, initp, nsects, fl = struct.unpack_from('<QQQQiiII', d, off+24)\n        print('  LC_SEGMENT_64 %-6s vmaddr=0x%x fileoff=0x%x nsects=%d' % (seg, vmaddr, fileoff, nsects))\n        so = off+72\n        for _ in range(nsects):\n            sn = d[so:so+16].rstrip(b'\\0').decode()\n            sg = d[so+16:so+32].rstrip(b'\\0').decode()\n            addr, size, offset = struct.unpack_from('<QQI', d, so+32)\n            print('      section %s,%s size=%d offset=0x%x' % (sg, sn, size, offset))\n            so += 80\n    elif cmd == 0xc:  # LC_LOAD_DYLIB\n        nameoff = struct.unpack_from('<I', d, off+8)[0]\n        nm = d[off+nameoff:off+cmdsize].split(b'\\0')[0].decode(errors='replace')\n        print('  LC_LOAD_DYLIB %s' % nm)\n    elif cmd == 0x2c:  # LC_ENCRYPTION_INFO_64\n        cryptoff, cryptsize, cryptid = struct.unpack_from('<III', d, off+8)\n        print('  LC_ENCRYPTION_INFO_64 cryptoff=0x%x cryptsize=%d cryptid=%d (%s)' %\n              (cryptoff, cryptsize, cryptid, 'DECRYPTED' if cryptid==0 else 'ENCRYPTED'))\n    elif cmd == 0x1d:  # LC_CODE_SIGNATURE\n        dataoff, datasize = struct.unpack_from('<II', d, off+8)\n        print('  LC_CODE_SIGNATURE dataoff=0x%x datasize=%d' % (dataoff, datasize))\n    else:\n        print('  LC cmd=0x%x size=%d' % (cmd, cmdsize))\n    off += cmdsize\n"
  }
 ],
