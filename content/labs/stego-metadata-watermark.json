{
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{3x1f_c0mm3nt_w4t3rm4rk}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: найти данные в метаданных изображения\n\n`watermark.jpg` выглядит как обычная картинка. В её метаданных спрятано сообщение.\n\n1. `file watermark.jpg` — обычный JPEG.\n2. `exiftool watermark.jpg` — прочитай метаданные (ImageDescription).\n3. Либо `strings watermark.jpg | grep nto` — метаданные лежат в файле сырыми.\n4. Запиши флаг в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/notes.txt",
      "text": "EXIF/XMP-поля хранятся в APP1-сегменте JPEG открытым текстом.\nСмена только метаданных не портит изображение.\n"
    },
    {
      "path": "/home/student/task/watermark.jpg",
      "b64": ""
    }
  ],
  "tools": {
    "exiftool": {
      "help": "exiftool <файл> — прочитать метаданные (эмуляция)",
      "cases": [
        {
          "match": "watermark\\.jpg",
          "example": "exiftool watermark.jpg",
          "output": "ExifTool Version Number         : 12.76\nFile Name                       : watermark.jpg\nFile Type                       : JPEG\nMIME Type                       : image/jpeg\nImage Width                     : 96\nImage Height                    : 96\nImage Description               : nto{3x1f_c0mm3nt_w4t3rm4rk}\nArtist                          : w4t3rm4rk-owner\n"
        },
        {
          "match": "--version",
          "example": "exiftool --version",
          "output": "12.76\n"
        }
      ]
    }
  },
  "id": "stego-metadata-watermark"
}
