{
  "id": "stegoanalysis-ws",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{ws_alpha_0_40_est}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: оценить payload методом Weighted Stego\n\n`lsb.bin` — 64×64 картинка в градациях серого, в неё встроено сообщение\nзаменой младшего бита. Оценщик WS считает долю `alpha` и печатает строку,\nзашитую в старшие байты в конце файла.\n\n1. `xxd -l 32 lsb.bin`.\n2. `python3 ws.py` — оценщик и извлечение метки.\n3. `python3 ws.py | grep nto > found.txt`.\n"
    },
    {
      "path": "/home/student/task/lsb.bin",
      "b64": ""
    },
    {
      "path": "/home/student/task/ws.py",
      "text": "import numpy as np\nd = np.frombuffer(open('lsb.bin','rb').read(), dtype=np.uint8)\nimg = d[:4096].reshape(64,64).astype(int)\nl = img & 1\nnum = den = 0.0\nfor dy,dx in ((-1,0),(1,0),(0,-1),(0,1)):\n    nb = np.roll(np.roll(img,dy,0),dx,1)\n    nbl = np.roll(np.roll(l,dy,0),dx,1)\n    wt = 1.0/(np.abs(img-nb)+1.0)\n    num += wt*nbl; den += wt\nalpha = 2.0*np.mean(l - num/den)\nprint('alpha_hat = %.4f' % alpha)\ntail = bytes(d[4096:])\ni = tail.find(b'nto{')\nprint(tail[i:tail.find(b'}', i)+1].decode())\n"
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция, вывод реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        },
        {
          "match": "ws\\.py",
          "example": "python3 ws.py",
          "output": "nto{ws_alpha_0_40_est}\n"
        }
      ]
    }
  }
}
