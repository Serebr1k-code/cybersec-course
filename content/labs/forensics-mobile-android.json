{
  "id": "forensics-mobile-android",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{andr01d_app_sql1t3_s3cr3t}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: данные приложения Android\n\nС телефона через ADB извлечён каталог приложения; `msgstore.db` — его SQLite-база. Восстанови переписку и найди секрет.\n\n1. `file msgstore.db` — формат.\n2. `sqlite3 msgstore.db \".tables\"` — таблицы.\n3. `sqlite3 msgstore.db \"SELECT sender,body FROM messages\"` — данные.\n\nФлаг `nto{...}` запиши в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/msgstore.db",
      "b64": "",
      "mode": "644"
    },
    {
      "path": "/home/student/task/notes.txt",
      "text": "Приложения Android хранят данные в SQLite под `/data/data/<package>/databases/`. Без root доступен `adb backup` (логическое извлечение); с root — прямое чтение файлов. Строки таблиц лежат в страницах БД открытым текстом, поэтому `strings` тоже работает.\n"
    }
  ],
  "tools": {
    "sqlite3": {
      "help": "sqlite3 <база> [SQL] — консоль SQLite (эмуляция)",
      "cases": [
        {
          "match": "\\.tables",
          "example": "sqlite3 msgstore.db \".tables\"",
          "output": "messages\n"
        },
        {
          "match": "SELECT.*body.*FROM messages",
          "example": "sqlite3 msgstore.db \"SELECT sender,body FROM messages\"",
          "output": "+79001234567|ок, буду в 20:00\n+79007654321|пароль от сейфа: nto{andr01d_app_sql1t3_s3cr3t}\n+79001234567|принял\n"
        },
        {
          "match": "msgstore\\.db",
          "example": "sqlite3 msgstore.db \".schema\"",
          "output": "CREATE TABLE messages(id INTEGER PRIMARY KEY, sender TEXT, body TEXT, ts TEXT);\n"
        }
      ],
      "fallback": "sqlite3: доступно `.tables` и `SELECT sender,body FROM messages`\n"
    }
  }
}
