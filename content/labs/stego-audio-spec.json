      "path": "/home/student/task/fsk.py",
      "text": "import wave, numpy as np\nw=wave.open('fsk.wav','rb'); n=w.getnframes()\nd=np.frombuffer(w.readframes(n),dtype='<i2').astype(float)\nbitlen=24; bits=''\nfor k in range(len(d)//bitlen):\n    seg=d[k*bitlen:(k+1)*bitlen]\n    spec=np.abs(np.fft.rfft(seg*np.hanning(len(seg))))\n    fr=np.fft.rfftfreq(len(seg),1/8000)\n    dom=fr[np.argmax(spec)]\n    bits += '1' if abs(dom-3000)<abs(dom-1000) else '0'\nbs=bytes(int(bits[i:i+8],2) for i in range(0,len(bits)//8*8,8))\nt=bs.decode('latin1'); i=t.find('nto{'); j=t.find('}',i)\nprint(t[i:j+1])\n"
