{
  "id": "stego-tool-stegoveritas",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{st3g0v3r1t4s_4ut0}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: автоматический разбор Stegoveritas\n\n`image.png` содержит скрытые данные. Прогони Stegoveritas и достань их.\n\n1. `stegoveritas image.png` — автоматический отчёт.\n2. Найди блок 'extracted data'.\n3. Запиши флаг в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/image.png",
      "b64": ""
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция, вывод реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        }
      ]
    },
    "stegoveritas": {
      "help": "stegoveritas <image> — автоматический стего-анализ (эмуляция)",
      "cases": [
        {
          "match": "image\\.png",
          "example": "stegoveritas image.png",
          "output": "[*] running metadata checks ... done\n[*] running LSB extraction ... nothing\n[*] running palette checks ... nothing\n[*] running appended-data check ... FOUND\n[+] extracted data (offset 0x4a2): nto{st3g0v3r1t4s_4ut0}\n"
        }
      ]
    }
  }
}
