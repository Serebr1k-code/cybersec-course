      "path": "/home/student/task/shamir_recover.py",
      "text": "#!/usr/bin/env python3\n# Shamir secret sharing: reconstruct the constant term from k shares (Lagrange).\nimport re\nt = open(\"shares.txt\").read()\np = int(re.search(r\"p = (\\d+)\", t).group(1))\nshares = [tuple(map(int, m)) for m in re.findall(r\"share (\\d+): (\\d+)\", t)]\nk = int(re.search(r\"k=(\\d+)\", t).group(1))\nuse = shares[:k]\nsecret = 0\nfor i, (xi, yi) in enumerate(use):\n    num = den = 1\n    for j, (xj, _) in enumerate(use):\n        if i == j:\n            continue\n        num = (num * (-xj)) % p\n        den = (den * (xi - xj)) % p\n    lag = num * pow(den, -1, p) % p\n    secret = (secret + yi * lag) % p\nmsg = secret.to_bytes((secret.bit_length() + 7) // 8, \"big\")\nprint(\"shares used:\", use)\nprint(\"reconstructed secret:\", msg.decode())\n"
    }
