{
  "id": "stego-tool-png-suite",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{png_ch3ck_chunk5}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: разбор чанков PNG\n\n`image.png` содержит нестандартный чанк с данными. Найди его через pngcheck и извлеки.\n\n1. `pngcheck -v image.png` — список чанков.\n2. Найди tEXt-чанк с флагом.\n3. Запиши флаг в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/image.png",
      "b64": ""
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция, вывод реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        }
      ]
    },
    "pngcheck": {
      "help": "pngcheck [-v|-c|-t] <file.png> — проверка структуры PNG (эмуляция)",
      "cases": [
        {
          "match": "-v\\s+image\\.png",
          "example": "pngcheck -v image.png",
          "output": "File: image.png (1234 bytes)\n  chunk IHDR at offset 0x0000c, length 13\n    16 x 16 image, 24-bit RGB, non-interlaced\n  chunk tEXt at offset 0x00025, length 34, CRC error\n    keyword: Comment\n    nto{png_ch3ck_chunk5}\n  chunk IDAT at offset 0x00053, length 120\n  chunk IEND at offset 0x000cf, length 0\n"
        },
        {
          "match": "-t\\s+image\\.png",
          "example": "pngcheck -t image.png",
          "output": "OK: image.png (1234 bytes)\n"
        }
      ]
    }
  }
}
