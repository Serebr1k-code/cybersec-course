{
  "id": "stego-ctf-unknown-file",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{unkn0wn_tr1ag3}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: триаж неизвестного файла\n\n`mystery.bin` — файл без описания. Определи формат, найди вложенные данные и извлеки флаг.\n\n1. `file mystery.bin`, `xxd -l 64 mystery.bin`.\n2. `binwalk mystery.bin` — карта.\n3. Извлеки и запиши флаг в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/mystery.bin",
      "b64": ""
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция, вывод реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        }
      ]
    },
    "file": {
      "help": "file <file> — определение типа (эмуляция)",
      "cases": [
        {
          "match": "mystery\\.bin",
          "example": "file mystery.bin",
          "output": "mystery.bin: PNG image data, 16 x 16, 8-bit/color RGB, non-interlaced\n"
        }
      ]
    },
    "binwalk": {
      "help": "binwalk [-e] <file> — сканирование сигнатур (эмуляция)",
      "cases": [
        {
          "match": "mystery\\.bin",
          "example": "binwalk mystery.bin",
          "output": "DECIMAL       HEXADECIMAL     DESCRIPTION\n0             0x0             PNG image, 16 x 16\n1186          0x4A2           Zip archive data, at least v2.0\n1450          0x5AA           End of Zip archive\n"
        },
        {
          "match": "-e\\s+mystery\\.bin",
          "example": "binwalk -e mystery.bin",
          "output": "Extracted 1 file\n_mystery.bin.extracted/note.txt: nto{unkn0wn_tr1ag3}\n"
        }
      ]
    }
  }
}
