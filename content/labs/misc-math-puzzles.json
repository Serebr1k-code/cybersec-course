    },
    {
      "path": "/home/student/task/math.py",
      "text": "print(\"nto{pr0j3ct_3ul3r_style}\")\n"
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт> — эмуляция (вывод захвачен из реального запуска)",
