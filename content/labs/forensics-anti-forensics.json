      "path": "/home/student/task/anti_detect.py",
      "text": "#!/usr/bin/env python3\n# Detect timestomping: $SI vs $FN timestamp mismatch in an MFT export.\nimport csv\nprint(\"%-14s %-19s %-19s %s\" % (\"FileName\", \"SI_Created\", \"FN_Created\", \"VERDICT\"))\nfor row in csv.DictReader(open(\"mft.csv\")):\n    ts = row[\"SI_Created\"] != row[\"FN_Created\"]\n    print(\"%-14s %-19s %-19s %s\" % (row[\"FileName\"], row[\"SI_Created\"],\n          row[\"FN_Created\"], \"TIMESTOMPED\" if ts else \"ok\"))\n"
    }
