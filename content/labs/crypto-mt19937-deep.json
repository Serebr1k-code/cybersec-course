      "path": "/home/student/task/untemper.py",
      "text": "outs=[int(l) for l in open('outputs.txt').read().split()]\nct=open('cipher.bin','rb').read()\ndef uright(y,sh):\n    x=y\n    for _ in range(5): x=y^(x>>sh)\n    return x&0xffffffff\ndef uleft(y,sh,mask):\n    x=y\n    for _ in range(5): x=y^((x<<sh)&mask)\n    return x&0xffffffff\ndef untemper(y):\n    y=uright(y,18)\n    y=uleft(y,15,0xefc60000)\n    y=uleft(y,7,0x9d2c5680)\n    y=uright(y,11)\n    return y&0xffffffff\nmt=[untemper(o) for o in outs]; idx=624\ndef twist():\n    global idx\n    for i in range(624):\n        y=(mt[i]&0x80000000)+(mt[(i+1)%624]&0x7fffffff)\n        mt[i]=mt[(i+397)%624]^(y>>1)\n        if y&1: mt[i]^=0x9908b0df\n    idx=0\ndef nxt():\n    global idx\n    if idx>=624: twist()\n    y=mt[idx]; idx+=1\n    y^=y>>11; y^=(y<<7)&0x9d2c5680; y^=(y<<15)&0xefc60000; y^=y>>18\n    return y&0xffffffff\nks=b''.join(nxt().to_bytes(4,'big') for _ in range(len(ct)//4+1))\npt=bytes(a^b for a,b in zip(ct,ks))\nprint(pt.decode('latin1'))\n"
    }
