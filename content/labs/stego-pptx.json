{
  "id": "stego-pptx",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{pptx_notes_slide}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: заметка докладчика в PPTX\n\n`talk.pptx` — презентация OOXML. Метка спрятана в notesSlide.\n\n1. `unzip -l talk.pptx`.\n2. `python3 pptx.py` — извлечение метки.\n3. `python3 pptx.py | grep nto > found.txt`.\n"
    },
    {
      "path": "/home/student/task/talk.pptx",
      "b64": ""
    },
    {
      "path": "/home/student/task/pptx.py",
      "text": "import zipfile, re\nz = zipfile.ZipFile('talk.pptx')\nfor name in z.namelist():\n    if 'notesSlide' in name:\n        txt = z.read(name).decode()\n        m = re.search(r'nto\\{[^}]*\\}', txt)\n        if m:\n            print(m.group(0))\n"
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция, вывод реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        },
        {
          "match": "pptx\\.py",
          "example": "python3 pptx.py",
          "output": "nto{pptx_notes_slide}\n"
        }
      ]
    }
  }
}
