{
  "id": "misc-esolang",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{br41nfuck_1nt3rpr3t3r}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: Brainfuck\n\nОпредели язык программы и запусти интерпретатор `bf program.txt`.\nПолученный флаг запиши в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/program.txt",
      "b64": ""
    }
  ],
  "tools": {
    "bf": {
      "help": "bf <файл> — интерпретатор Brainfuck (вывод захвачен из реального запуска)",
      "cases": [
        {
          "match": "program\\.txt",
          "output": "nto{br41nfuck_1nt3rpr3t3r}\n"
        }
      ],
      "fallback": "bf: доступно `bf program.txt`\n"
    }
  }
