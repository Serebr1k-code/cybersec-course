      "text": "def unshift_right(y, shift):\n    x = 0\n    for i in range(31, -1, -1):\n        bit = (y >> i) & 1\n        if i + shift < 32:\n            bit ^= (x >> (i + shift)) & 1\n        x |= bit << i\n    return x\ndef unshift_left_mask(y, shift, mask):\n    x = 0\n    for i in range(32):\n        bit = (y >> i) & 1\n        if i - shift >= 0:\n            bit ^= ((x >> (i - shift)) & 1) & ((mask >> i) & 1)\n        x |= bit << i\n    return x\ndef untemper(y):\n    y = unshift_right(y, 18)\n    y = unshift_left_mask(y, 15, 0xefc60000)\n    y = unshift_left_mask(y, 7, 0x9d2c5680)\n    y = unshift_right(y, 11)\n    return y & 0xffffffff\nMT = 624; A = 0x9908b0df; UPPER = 0x80000000; LOWER = 0x7fffffff\nouts = [int(l) for l in open('outputs.txt').read().split()]\nst = [untemper(o) for o in outs[:624]]\nidx = 624\ndef gen():\n    global idx\n    if idx >= MT:\n        for i in range(MT):\n            y = (st[i] & UPPER) | (st[(i+1) % MT] & LOWER)\n            st[i] = st[(i + 397) % MT] ^ (y >> 1) ^ (A if y & 1 else 0)\n        idx = 0\n    y = st[idx]; idx += 1\n    y ^= y >> 11\n    y ^= (y << 7) & 0x9d2c5680\n    y ^= (y << 15) & 0xefc60000\n    y ^= y >> 18\n    return y & 0xffffffff\nct = open('cipher.bin','rb').read()\nks = [gen() for _ in range((len(ct) + 3) // 4)]\npt = bytes(b ^ ((ks[i//4] >> (8*(i%4))) & 0xff) for i, b in enumerate(ct))\nprint(pt.decode())\n"
