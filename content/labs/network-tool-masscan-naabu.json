{
  "id": "network-tool-masscan-naabu",
  "hostname": "lab",
  "workdir": "/home/student/task",
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: перечислить все открытые порты\n\nСправочник по массовому сканированию — теперь практика. Прогони naabu по\n`scanme.nmap.org` и собери **все** открытые порты:\n\n    naabu -host scanme.nmap.org -top-ports 100 -silent\n\nЗапиши через запятую **номера всех открытых портов по возрастанию**\n(например `21,22,80`) в файл `answer.txt` и набери `check`.\n"
    }
  ],
  "expect": {
    "file": "/home/student/task/answer.txt",
    "contains": "21,22,80"
  },
  "tools": {
    "naabu": {
      "help": "naabu -host <цель> [-top-ports N] — быстрый сканер портов",
      "cases": [
        {
          "match": "top-ports",
          "example": "-host scanme.nmap.org -top-ports 100 -silent",
          "output": "scanme.nmap.org:21\nscanme.nmap.org:22\nscanme.nmap.org:80\n"
        },
        {
          "match": "scanme",
          "example": "-host scanme.nmap.org -top-ports 100",
          "output": "scanme.nmap.org:21\nscanme.nmap.org:22\nscanme.nmap.org:80\n"
        }
      ],
      "fallback": "scanme.nmap.org:21\nscanme.nmap.org:22\nscanme.nmap.org:80\n"
    }
  }
}
