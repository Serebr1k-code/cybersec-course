{
  "id": "mobile-backup",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{4db_b4ckup_3xf1ltr4t3s}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: разобрать backup приложения\n\n`backup.tar` — резервная копия приложения (tar). Внутри есть `shared_prefs`\nприложения. В них оставлен отладочный токен. Достань его и запиши в `found.txt`.\n\nИнструмент `tar` эмулируется (вывод реального tar).\nПолезно: `tar -tvf backup.tar`, затем `tar -xOf backup.tar apps/com.vanta.app/f/prefs.xml`.\n"
    },
    {
      "path": "/home/student/task/backup.tar",
      "b64": "",
      "mode": "644"
    }
  ],
  "tools": {
    "tar": {
      "help": "tar -tvf <архив> | tar -xOf <архив> <файл> — список/печать (эмуляция, вывод реального tar)",
      "cases": [
        {
          "match": "-t",
          "example": "-tvf backup.tar",
          "output": "drwxr-xr-x Serebr1k/Serebr1k 0 2026-10-13 12:25 apps/\ndrwxr-xr-x Serebr1k/Serebr1k 0 2026-10-13 12:25 apps/com.vanta.app/\ndrwxr-xr-x Serebr1k/Serebr1k 0 2026-10-13 12:25 apps/com.vanta.app/db/\n-rw-r--r-- Serebr1k/Serebr1k 30 2026-10-13 12:25 apps/com.vanta.app/db/app.db\ndrwxr-xr-x Serebr1k/Serebr1k 0 2026-10-13 12:25 apps/com.vanta.app/f/\n-rw-r--r-- Serebr1k/Serebr1k 193 2026-10-13 12:25 apps/com.vanta.app/f/prefs.xml\n"
        },
        {
          "match": "-xO.*prefs\\.xml",
          "example": "-xOf backup.tar apps/com.vanta.app/f/prefs.xml",
          "output": "<?xml version='1.0' encoding='utf-8' standalone='yes' ?>\n<map>\n  <string name=\"server\">https://api.vanta.local</string>\n  <string name=\"debug_token\">nto{4db_b4ckup_3xf1ltr4t3s}</string>\n</map>\n"
        },
        {
          "match": "-xO.*app\\.db",
          "example": "-xOf backup.tar apps/com.vanta.app/db/app.db",
          "output": "SQLite format 3 (placeholder)\n"
        }
      ]
    }
  }
}
