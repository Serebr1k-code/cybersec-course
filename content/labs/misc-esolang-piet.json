{
  "id": "misc-esolang-piet",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{p13t_1s_4_p1ctur3_l4ngu4g3}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: Piet\n\n`hello.png` — эталонная Piet-программа (печатает «Hi»).\n`art.png` — программа-задача: исполни картинку и получи флаг.\nФлаг запиши в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/hello.png",
      "b64": ""
    },
    {
      "path": "/home/student/task/art.png",
      "b64": ""
    }
  ],
  "tools": {
    "npiet": {
      "help": "npiet [-t] <файл.png> — эталонный интерпретатор Piet (вывод захвачен из реального прогона)",
      "cases": [
        {
          "match": "hello\\.png",
          "output": "Hi\n"
        },
        {
          "match": "art\\.png",
          "output": "nto{p13t_1s_4_p1ctur3_l4ngu4g3}"
        }
      ],
      "fallback": "npiet: доступно `npiet hello.png` и `npiet art.png`\n"
    }
  }
}
