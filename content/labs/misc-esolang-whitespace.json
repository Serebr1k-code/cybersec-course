{
  "id": "misc-esolang-whitespace",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{wh1t3sp4c3_1s_1nv1s1bl3}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: Whitespace\n\nФайл кажется пустым. Разбери его байты и запусти `ws program.ws`.\nФлаг запиши в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/program.ws",
      "b64": ""
    }
  ],
  "tools": {
    "ws": {
      "help": "ws <файл> — интерпретатор Whitespace (вывод захвачен из реального запуска)",
      "cases": [
        {
          "match": "program\\.ws",
          "output": "nto{wh1t3sp4c3_1s_1nv1s1bl3}\n"
        }
      ],
      "fallback": "ws: доступно `ws program.ws`\n"
    }
  }
}
