{
  "id": "reversing-firmware-basics",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{f1rmw4r3_squ4shfs_c4rv3d}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: базовый разбор прошивки\n\n`firmware.bin` — образ прошивки: заголовок `NT-FIRMWARE`, далее встроенная\nфайловая система SquashFS с файлом `secret.txt`.\n\n1. `binwalk firmware.bin` — найди смещение SquashFS.\n2. Вырежи ФС: `dd if=firmware.bin of=root.sqfs bs=1 skip=<offset>`.\n3. `strings root.sqfs | grep nto` — содержимое файлов SquashFS.\n\nФлаг запиши в `found.txt` и набери `check`.\n"
    },
    {
      "path": "/home/student/task/firmware.bin",
      "b64": "",
      "mode": "644"
    }
  ],
  "tools": {
    "binwalk": {
      "help": "binwalk <файл> — поиск встроенных сигнатур",
      "cases": [
        {
          "match": "firmware\\.bin",
          "example": "binwalk firmware.bin",
          "output": "\nDECIMAL       HEXADECIMAL     DESCRIPTION\n--------------------------------------------------------------------------------\n24            0x18            Squashfs filesystem, little endian, version 4.0, compression:gzip, size: 544 bytes, 6 inodes, blocksize: 131072 bytes, created: 2026-10-13 15:06:20\n\n"
        }
      ]
    }
  }
}
