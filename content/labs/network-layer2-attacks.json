{
  "id": "network-layer2-attacks",
  "hostname": "lab",
  "workdir": "/home/student/task",
  "expect": {
    "file": "/home/student/task/answer.txt",
    "contains": "S3cret!"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: MAC-flooding → перехват пароля\n\n`macof` переполнил CAM-таблицу коммутатора случайными MAC. Коммутатор начал флудить кадры\nво все порты — как хаб. В `flood.pcap` среди шума есть чужой HTTP-логин.\n\nНайди **пароль** из перехваченного POST-запроса.\n\n1. Сводка: `tshark -r flood.pcap -nn`\n2. Поля POST: `tshark -r flood.pcap -Y 'http.request' -T fields -e ip.src -e http.host -e urlencoded-form.key -e urlencoded-form.value`\n\nЗапиши пароль в `answer.txt` и набери `check`.\n"
    },
    {
      "path": "/home/student/task/flood.pcap",
      "b64": "",
      "mode": "644"
    }
  ],
  "tools": {
    "tshark": {
      "help": "tshark -r <pcap> [-nn] [-V] [-Y <фильтр>] [-T fields -e <поле>] — разбор дампа (эмуляция: реальный вывод tshark)",
      "cases": [
        {
          "match": "urlencoded-form",
          "example": "-r flood.pcap -Y 'http.request' -T fields -e ip.src -e http.host -e urlencoded-form.key -e urlencoded-form.value",
          "output": "10.0.0.50\tportal.corp.local\tusername,password\tivanov,S3cret!\n"
        },
        {
          "match": "flood\\.pcap",
          "example": "-r flood.pcap -nn",
          "output": "    1   0.000000   10.0.0.186 → 10.0.0.254   UDP 62 46837 → 19706 Len=20\n    2   0.001000   10.0.0.162 → 10.0.0.254   UDP 62 23452 → 64947 Len=20\n    3   0.002000   10.0.0.66 → 10.0.0.254    UDP 62 51000 → 40001 Len=20\n   41   1.000000    10.0.0.50 → 10.0.0.1     HTTP 204 POST /login HTTP/1.1  (application/x-www-form-urlencoded)\n"
        }
      ],
      "fallback": "    1   0.000000   10.0.0.186 → 10.0.0.254   UDP 62 46837 → 19706 Len=20\n    2   0.001000   10.0.0.162 → 10.0.0.254   UDP 62 23452 → 64947 Len=20\n    3   0.002000   10.0.0.66 → 10.0.0.254    UDP 62 51000 → 40001 Len=20\n   41   1.000000    10.0.0.50 → 10.0.0.1     HTTP 204 POST /login HTTP/1.1  (application/x-www-form-urlencoded)\n"
    }
  }
}
