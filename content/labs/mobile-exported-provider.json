{
  "id": "mobile-exported-provider",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{c0nt3nt_pr0v1d3r_l34k}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: утечка через экспортированный ContentProvider\n\nЭкспортированный ContentProvider отдаёт базу `databases/app.db`. База — обычный\nSQLite (настоящий файл). Достань из неё флаг и запиши в `found.txt`.\n\nИнструмент `sqlite3 <db> '<SQL>'` эмулируется (вывод реального sqlite3).\nПолезно: `sqlite3 databases/app.db '.tables'`, затем `SELECT * FROM secrets;`.\n"
    },
    {
      "path": "/home/student/task/databases",
      "type": "dir"
    },
    {
      "path": "/home/student/task/databases/app.db",
      "b64": "",
      "mode": "644"
    }
  ],
  "tools": {
    "sqlite3": {
      "help": "sqlite3 <db> '<SQL|.команда>' — эмуляция (вывод захвачен с реального sqlite3)",
      "cases": [
        {
          "match": "\\.tables",
          "example": ".tables",
          "output": "secrets  users\n"
        },
        {
          "match": "SELECT.*FROM\\s+secrets",
          "example": "SELECT * FROM secrets;",
          "output": "1|api|nto{c0nt3nt_pr0v1d3r_l34k}\n"
        },
        {
          "match": "SELECT.*FROM\\s+users",
          "example": "SELECT * FROM users;",
          "output": "1|alice\n2|bob\n"
        }
      ]
    }
  }
}
