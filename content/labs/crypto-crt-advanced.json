      "text": "from functools import reduce\nns=[int(x) for x in open('moduli.txt').read().split()]\ncs=[int(x) for x in open('ciphertexts.txt').read().split()]\ne=3\n# CRT: combine the three congruences x = c_i (mod n_i) into x = m^e (mod N)\ndef crt(rs,ms):\n    N=reduce(lambda a,b:a*b,ms)\n    x=0\n    for r,mi in zip(rs,ms):\n        Ni=N//mi\n        x=(x+r*Ni*pow(Ni,-1,mi))%N\n    return x\nx=crt(cs,ns)\ndef iroot(n,k):\n    lo,hi=0,1\n    while hi**k<=n: hi*=2\n    while lo<hi:\n        mid=(lo+hi)//2\n        if mid**k<n: lo=mid+1\n        else: hi=mid\n    return lo\nm=iroot(x,e)\nprint(m.to_bytes((m.bit_length()+7)//8,'big').decode())\n"
