{
  "id": "stego-video-audio-mux",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{h1dd3n_subt1tl3_tr4ck}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача\n\n`container.mp4` — MP4 с видео и звуком. Подсказка: в контейнере есть лишняя дорожка. Достань из неё флаг.\n"
    },
    {
      "path": "/home/student/task/container.mp4",
      "b64": "",
      "mode": "644"
    },
    {
      "path": "/home/student/task/tracks.py",
      "text": "import struct\ndata = open(\"container.mp4\", \"rb\").read()\noff = 0\nwhile off + 8 <= len(data):\n    size, typ = struct.unpack(\">I4s\", data[off:off+8])\n    if size < 8: break\n    if typ == b\"sub1\":\n        print(\"streams: video, audio, subtitle(eng)\")\n        print(\"subtitle payload:\", data[off+8:off+size].decode())\n    off += size\n"
    }
  ],
  "tools": {
    "ffprobe": {
      "help": "ffprobe [-show_streams] <файл> — параметры потоков",
      "cases": [
        {
          "match": "container\\.mp4",
          "example": "ffprobe -v error -show_streams container.mp4",
          "output": "[STREAM]\nindex=0\ncodec_type=video\ncodec_name=h264\n[/STREAM]\n[STREAM]\nindex=1\ncodec_type=audio\ncodec_name=aac\n[/STREAM]\n[STREAM]\nindex=2\ncodec_type=subtitle\ncodec_name=mov_text\nlanguage=eng\n[/STREAM]\n"
        }
      ]
    },
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4\n"
        },
        {
          "match": "tracks\\.py",
          "example": "python3 tracks.py",
          "output": "streams: video, audio, subtitle(eng)\nsubtitle payload: nto{h1dd3n_subt1tl3_tr4ck}\n"
        }
      ]
    }
  }
}
