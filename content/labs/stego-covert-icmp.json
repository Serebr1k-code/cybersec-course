    {
      "path": "/home/student/task/icmp_decode.py",
      "text": "# The echo payloads carry the message; tshark prints them as hex.\nimport binascii\nhexs = [\n \"6e746f7b31636d705f7034796c3034645f6330763372745f6368346e6e336c7d\",\n]\ndata = b\"\".join(binascii.unhexlify(h) for h in hexs)\ni = data.find(b\"nto{\")\nprint(data[i:i+40].split(b\"\\x00\")[0].decode())\n"
