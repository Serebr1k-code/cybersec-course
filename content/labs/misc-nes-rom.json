{
  "id": "misc-nes-rom",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{n3s_1nes_m4pp3r_chr}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# NES ROM\n\nВ `game.nes` спрятан флаг. Разбери заголовок iNES и найди его.\n"
    },
    {
      "path": "/home/student/task/game.nes",
      "b64": "",
      "mode": "644"
    }
  ],
  "tools": {
    "strings": {
      "help": "strings <файл> — печатаемые строки",
      "cases": [
        {
          "match": "game\\.nes",
          "example": "strings game.nes",
          "output": "NES\u001a\nnto{n3s_1nes_m4pp3r_chr}"
        }
      ]
    }
  }
