{
  "id": "stego-raw-photo",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{r4w_m4k3rn0t3_n3f}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача\n\n`holiday.nef` — RAW-фото Nikon. Подсказка: «камера сохранила больше, чем один кадр». Разбери контейнер и найди флаг.\n"
    },
    {
      "path": "/home/student/task/holiday.nef",
      "b64": "",
      "mode": "644"
    },
    {
      "path": "/home/student/task/info.py",
      "text": "data = open(\"holiday.nef\", \"rb\").read()\nprint(\"holiday.nef: TIFF image data, big-endian\")\nprint(\"bytes:\", len(data))\n"
    },
    {
      "path": "/home/student/task/extract.py",
      "text": "data = open(\"holiday.nef\", \"rb\").read()\ni = data.find(b\"nto{\")\nj = data.find(b\"}\", i)\nprint(data[i:j+1].decode())\n"
    }
  ],
  "tools": {
    "exiftool": {
      "help": "exiftool [-a -u -g1 | -b -TAG] <файл> — метаданные",
      "cases": [
        {
          "match": "-a\\s+-u\\s+-g1",
          "example": "exiftool -a -u -g1 holiday.nef",
          "output": "[ExifTool]      ExifToolVersion : 12.60\n[File]          FileType        : NEF\n[IFD0]          Make            : NIKON CORPORATION\n[IFD0]          Model           : NIKON D5600\n[SubIFD]        JpgFromRaw      : (Binary data 2456789 bytes, use -b option to extract)\n[IFD0]          MakerNoteNikon  : (Binary data 48 bytes, use -b option to extract)\n"
        },
        {
          "match": "-b\\s+-MakerNoteNikon",
          "example": "exiftool -b -MakerNoteNikon holiday.nef",
          "output": "NIKON\u0000\u0000JpgFromRaw\u0000nto{r4w_m4k3rn0t3_n3f}\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000"
        }
      ]
    },
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4\n"
        },
        {
          "match": "info\\.py",
          "example": "python3 info.py",
          "output": "holiday.nef: TIFF image data, big-endian\n"
        },
        {
          "match": "extract\\.py",
          "example": "python3 extract.py",
          "output": "nto{r4w_m4k3rn0t3_n3f}\n"
        }
      ]
    }
  }
}
