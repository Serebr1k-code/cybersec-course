{
  "id": "forensics-img-encryption",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/answer.txt",
    "contains": "nto{luks_h34d3r_l34ks_th3_l4b3l}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: определить шифрование и прочитать заголовок\n\n## Повторение\n\nИз `forensics-img-acquisition` помнишь: с образом работают по заголовкам. Этот образ зашифрован, но заголовок LUKS открыт — смотри: `cryptsetup luksDump luks.img`.\n\nОбраз `luks.img` — зашифрованный том. Без ключа данные неразличимы, но заголовок\nLUKS открыт и содержит метаданные (шифр, слоты, label). Разбери его.\n\n1. Сигнатура: `xxd -l 16 luks.img` (`4c554b53 babe` = LUKS).\n2. Заголовок: `cryptsetup luksDump luks.img > dump.txt`.\n3. Метка в заголовке: `grep nto dump.txt > answer.txt`.\n"
    },
    {
      "path": "/home/student/task/luks.img",
      "b64": "",
      "mode": "644"
    }
  ],
  "tools": {
    "cryptsetup": {
      "help": "cryptsetup luksDump <образ> — заголовок LUKS",
      "cases": [
        {
          "match": "luksdump",
          "example": "luksDump luks.img",
          "output": "LUKS header information\nVersion:        2\nUUID:           3f2a9c1b-8d4e-6f0a-2c5b-9d1e7f3a4b6c\nLabel:          nto{luks_h34d3r_l34ks_th3_l4b3l}\nCipher name:    aes\nCipher mode:    xts-plain64\nHash spec:      sha256\nKeyslots:\n  0: luks2 (aes-xts-plain64, 512 bit)\n"
        }
      ]
    }
  }
}
