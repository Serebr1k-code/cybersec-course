{
 "id": "forensics-fs-internals",
 "workdir": "/home/student/task",
 "hostname": "lab",
 "expect": {
  "file": "/home/student/task/answer.txt",
  "contains": "nto{3xt4_j0urn4l_r3c0v3rs_d3l3t3d}"
 },
 "fs": [
  {
   "path": "/home/student/task",
   "type": "dir"
  },
  {
   "path": "/home/student/task/task.md",
   "text": "# Задача: журнал ext4 хранит историю\n\nВ образе `ext4.img` злоумышленник удалил файл. Метаданные ФС и журнал (journal)\nсохраняют следы операции. Найди удалённый файл и метку в нём.\n\n1. Проверь сигнатуру суперблока: `xxd -s 0x438 -l 2 ext4.img` (`53ef` = ext2/3/4).\n2. Параметры ФС: `dumpe2fs -h ext4.img`.\n3. Удалённые inode: `debugfs -R \"lsdel\" ext4.img`.\n4. Прочитай удалённый файл: `debugfs -R \"cat /secret.txt\" ext4.img > out.txt`.\n5. Метка: `grep nto out.txt > answer.txt`.\n"
  },
  {
   "path": "/home/student/task/ext4.img",
   "b64": "",
   "mode": "644"
  }
 ],
 "tools": {
  "dumpe2fs": {
   "help": "dumpe2fs [-h] <образ> — параметры ext2/3/4",
   "cases": [
    {
     "match": "ext4\\.img",
     "example": "-h ext4.img",
     "output": "Filesystem volume name:   <none>\nFilesystem features:      has_journal ext_attr resize_inode dir_index\nFilesystem state:         clean\nJournal size:             4096k\n"
    }
   ]
  },
  "debugfs": {
   "help": "debugfs -R \"<команда>\" <образ> — доступ к ext-ФС",
   "cases": [
    {
     "match": "lsdel",
     "example": "-R \"lsdel\" ext4.img",
     "output": " Inode  Owner  Mode    Size    Blocks   Time deleted\n  13      0  100644   1024      2     Wed Oct  9 22:19:04 2024\n1 deleted inodes found.\n"
    },
    {
     "match": "secret",
     "example": "-R \"cat /secret.txt\" ext4.img",
     "output": "client database dump\nnto{3xt4_j0urn4l_r3c0v3rs_d3l3t3d}\n"
    }
   ]
  }
 }
}
