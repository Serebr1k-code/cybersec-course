{
  "id": "mobile-insecure-storage",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{1n53cur3_5t0r4g3}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: небезопасное хранение\n\nДамп данных приложения: `shared_prefs/` и `databases/`. Токен сессии хранится\nв открытом виде. Найди его и запиши в `found.txt`.\n\nПолезно: `grep -r token shared_prefs/`, `strings databases/app.db`, `sqlite3`.\n"
    },
    {
      "path": "/home/student/task/shared_prefs",
      "type": "dir"
    },
    {
      "path": "/home/student/task/shared_prefs/com.vanta.lab_preferences.xml",
      "text": "<?xml version='1.0' encoding='utf-8' standalone='yes' ?>\n<map>\n    <string name=\"username\">mira</string>\n    <string name=\"auth_token\">nto{1n53cur3_5t0r4g3}</string>\n    <string name=\"encrypted_blob\">AES/CBC/PKCS5Padding:3f9a...decoy</string>\n    <boolean name=\"logged_in\" value=\"true\" />\n</map>\n"
    },
    {
      "path": "/home/student/task/databases",
      "type": "dir"
    },
    {
      "path": "/home/student/task/databases/app.db",
      "b64": ""
    }
  ],
  "tools": {
    "sqlite3": {
      "help": "sqlite3 <файл> \"<SQL>\" — запрос к базе (эмуляция, вывод захвачен с реального sqlite3)",
      "cases": [
        {
          "match": "sessions",
          "example": "databases/app.db \"SELECT * FROM sessions;\"",
          "output": "id  user           token\n--  -----  ---------------------\n 1  mira   nto{1n53cur3_5t0r4g3}\n 2  guest  null\n"
        }
      ],
      "fallback": "Error: in this lab only `SELECT * FROM sessions;` is available.\n"
    }
  }
}
