{
  "id": "crypto-disk-encryption",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{luks_w34k_p4ssphr4s3}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: LUKS и слабый KDF\n\n`luks_disk.img` — контейнер LUKS, `luks_keyslot.bin` — verifier keyslot.\n\n1. Разбери заголовок: `python3 luks_dump.py` (или `cryptsetup luksDump luks_disk.img`).\n2. Перебери курированный список паролей: `python3 luks_crack.py`.\n\nВосстановленный пароль — это флаг `nto{...}`. Запиши его в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/luks_disk.img",
      "b64": ""
    },
    {
      "path": "/home/student/task/luks_keyslot.bin",
      "b64": "8cc8HwdAhuPjKrhRDIXyWFiGEfd2k5oLymoXpM23IRw="
    },
    {
      "path": "/home/student/task/luks_dump.py",
      "text": "#!/usr/bin/env python3\n# Minimal luksDump: parse the LUKS1 header.\nimport struct\nh = open(\"luks_disk.img\", \"rb\").read(592)\nassert h[:6] == b\"LUKS\\xba\\xbe\", \"not a LUKS container\"\nver = struct.unpack(\">H\", h[6:8])[0]\ncipher = h[8:40].rstrip(b\"\\x00\").decode()\nmode = h[40:72].rstrip(b\"\\x00\").decode()\nhsh = h[72:104].rstrip(b\"\\x00\").decode()\noff = struct.unpack(\">I\", h[104:108])[0]\nkb = struct.unpack(\">I\", h[108:112])[0]\nuuid = h[156:172].hex()\nprint(\"Version:        %d\" % ver)\nprint(\"Cipher name:    %s\" % cipher)\nprint(\"Cipher mode:    %s\" % mode)\nprint(\"Hash spec:      %s\" % hsh)\nprint(\"Payload offset: %d\" % off)\nprint(\"MK bits:        %d\" % (kb * 8))\nprint(\"UUID:           %s\" % uuid)\n"
    },
    {
      "path": "/home/student/task/luks_crack.py",
      "text": "#!/usr/bin/env python3\n# LUKS1: passphrase -> PBKDF2-HMAC-SHA256 -> keyslot-key; verify against keyslot.\nimport hashlib, struct\nhdr = open(\"luks_disk.img\", \"rb\").read(592)\nsalt = hdr[180:212]\niters = struct.unpack(\">I\", hdr[176:180])[0]\nverifier = open(\"luks_keyslot.bin\", \"rb\").read()\nwordlist = [\"password\", \"123456\", \"letmein\", \"changeme\", \"admin\",\n            \"luks\", \"secret\", \"nto{luks_w34k_p4ssphr4s3}\"]\nfor w in wordlist:\n    dk = hashlib.pbkdf2_hmac(\"sha256\", w.encode(), salt, iters, 32)\n    if hashlib.sha256(dk).digest() == verifier:\n        print(\"candidate %-30s -> PBKDF2 match!\" % w)\n        print(\"passphrase recovered:\", w)\n        break\nelse:\n    print(\"no passphrase in wordlist\")\n"
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (вывод захвачен из реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        },
        {
          "match": "luks_dump\\.py",
          "example": "python3 luks_dump.py",
          "output": "Version:        1\nCipher name:    aes\nCipher mode:    xts-plain64\nHash spec:      sha256\nPayload offset: 4096\nMK bits:        256\nUUID:           b182a0ccfe2043559bcf3a0e83dddbf6\n"
        },
        {
          "match": "luks_crack\\.py",
          "example": "python3 luks_crack.py",
          "output": "candidate nto{luks_w34k_p4ssphr4s3}      -> PBKDF2 match!\npassphrase recovered: nto{luks_w34k_p4ssphr4s3}\n"
        }
      ],
      "fallback": "python3: доступно `python3 luks_dump.py`\n"
    },
    "cryptsetup": {
      "help": "cryptsetup luksDump <образ> — информация о LUKS-контейнере",
      "cases": [
        {
          "match": "luksDump",
          "example": "cryptsetup luksDump luks_disk.img",
          "output": "LUKS header information for luks_disk.img\n\nVersion:        1\nCipher name:    aes\nCipher mode:    xts-plain64\nHash spec:      sha256\nPayload offset: 4096\nMK bits:        256\nUUID:           b182a0cc-fe20-4355-9bcf-3a0e83dddbf6\n\nKey Slot 0: ENABLED\n\tIterations:\t2000\n\tSalt:\t00 01 02 03 ...\n\tKey material offset:\t8\n\tAF stripes:\t4000\nKey Slot 1: DISABLED\n"
        }
      ]
    }
  }
}
