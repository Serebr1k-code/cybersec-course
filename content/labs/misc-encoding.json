{
  "id": "misc-encoding",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{qr_c0d3s_4r3_just_d4t4}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: QR-код\n\nКартинка `qr.png` содержит QR-код. Декодируй его и вытащи флаг.\n\nПодсказка: QR-коды читает `zbarimg`. Запиши флаг в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/qr.png",
      "b64": ""
    },
    {
      "path": "/home/student/task/notes.txt",
      "text": "В прошлый раз в ресурсах лежал decoy-код. Смотри только на `qr.png`.\n"
    }
  ],
  "tools": {
    "zbarimg": {
      "help": "zbarimg [-q] <изображение> — декодировать штрих/QR-код (вывод захвачен из реального zbarimg)",
      "cases": [
        {
          "match": "qr\\.png",
          "example": "zbarimg -q qr.png",
          "output": "QR-Code:nto{qr_c0d3s_4r3_just_d4t4}\n"
        }
      ],
      "fallback": "zbarimg: в этой лабе доступно `zbarimg -q qr.png`\n"
    }
  }
}
