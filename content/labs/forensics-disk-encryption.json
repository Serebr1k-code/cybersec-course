{
 "id": "forensics-disk-encryption",
 "workdir": "/home/student/task",
 "hostname": "lab",
 "vars": {},
 "expect": {
  "file": "/home/student/task/found.txt",
  "contains": "nto{luks1_aes_xts-plain64_64_sha256}"
 },
 "fs": [
  {
   "path": "/home/student/task",
   "type": "dir"
  },
  {
   "path": "/home/student/task/task.md",
   "text": "# Задача: разбор заголовка LUKS\n\nДан заголовок шифрованного диска LUKS1. Определи версию, шифр, режим, размер ключа\nи хэш, затем запиши флаг в формате `nto{luks1_<cipher>_<mode>_<keybytes>_<hash>}` в `found.txt`.\n"
  },
  {
   "path": "/home/student/task/disk.img",
   "b64": "",
   "mode": "644"
  },
  {
   "path": "/home/student/task/parse_luks.py",
   "text": "# Parse a LUKS1 header: magic, cipher spec, key size and keyslot metadata.\nimport struct, sys\ndata = open(sys.argv[1] if len(sys.argv) > 1 else \"disk.img\", \"rb\").read(592)\nassert data[:6] == b\"LUKS\\xba\\xbe\", \"not a LUKS header\"\nversion = struct.unpack_from(\">H\", data, 6)[0]\ncipher = data[8:40].split(b\"\\x00\")[0].decode()\nmode = data[40:72].split(b\"\\x00\")[0].decode()\nhashspec = data[72:104].split(b\"\\x00\")[0].decode()\npayload, keybytes = struct.unpack_from(\">II\", data, 104)\nuuid = data[168:208].split(b\"\\x00\")[0].decode()\nactive, iters = struct.unpack_from(\">II\", data, 208)\nprint(\"LUKS version :\", version)\nprint(\"cipher       :\", cipher)\nprint(\"mode         :\", mode)\nprint(\"hash         :\", hashspec)\nprint(\"key bytes    :\", keybytes)\nprint(\"payload off  :\", payload)\nprint(\"UUID         :\", uuid)\nprint(\"keyslot0     : active=%s iterations=%d\" % (active == 0x00AC71F3, iters))\nif version == 1 and active == 0x00AC71F3:\n    print(\"flag: nto{luks1_%s_%s_%d_%s}\" % (cipher, mode, keybytes, hashspec))\n"
  }
 ],
 "tools": {
  "python3": {
   "help": "python3 <скрипт.py> — интерпретатор Python (вывод захвачен из реального запуска)",
   "cases": [
    {
     "match": "--version|^-V$",
     "example": "python3 --version",
     "output": "Python 3.12.4"
    },
    {
     "match": "parse_luks\\.py",
     "example": "python3 parse_luks.py",
     "output": "LUKS version : 1\ncipher       : aes\nmode         : xts-plain64\nhash         : sha256\nkey bytes    : 64\npayload off  : 4096\nUUID         : 7b190654-cf86-4cf9-b81c-94a94c925a2b\nkeyslot0     : active=True iterations=38339\nflag: nto{luks1_aes_xts-plain64_64_sha256}\n"
    }
   ],
   "fallback": "python3: доступно `python3 parse_luks.py`\n"
  }
 }
}