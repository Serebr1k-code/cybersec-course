{
  "id": "stego-video-frames",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{v1d30_h1dd3n_fr4m3}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача\n\n`clip.mp4` — короткое видео. Метаданные чистые, аудио нет, значит данные — в одном из кадров. Найди его и достань флаг.\n"
    },
    {
      "path": "/home/student/task/clip.mp4",
      "b64": "",
      "mode": "644"
    },
    {
      "path": "/home/student/task/frames",
      "type": "dir"
    },
    {
      "path": "/home/student/task/frames/00217.png",
      "b64": "",
      "mode": "644"
    },
    {
      "path": "/home/student/task/frame.py",
      "text": "# Сравнение кадров: находит кадр, сильнее всего отличающийся от первого.\nprint(\"scanned 30 frames; outlier: frames/00217.png (AE=18432, next=210)\")\n"
    }
  ],
  "tools": {
    "ffprobe": {
      "help": "ffprobe [-show_streams] <файл> — параметры потоков",
      "cases": [
        {
          "match": "clip\\.mp4",
          "example": "ffprobe -v error -show_streams clip.mp4",
          "output": "[STREAM]\nindex=0\ncodec_name=h264\nwidth=128\nheight=96\nnb_frames=30\n[/STREAM]\n"
        }
      ]
    },
    "zbarimg": {
      "help": "zbarimg [-q] <изображение> — декодер QR/штрихкодов",
      "cases": [
        {
          "match": "00217\\.png",
          "example": "zbarimg frames/00217.png",
          "output": "QR-Code:nto{v1d30_h1dd3n_fr4m3}\n"
        }
      ]
    },
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4\n"
        },
        {
          "match": "frame\\.py",
          "example": "python3 frame.py",
          "output": "scanned 30 frames; outlier: frames/00217.png (AE=18432, next=210)\n"
        }
      ]
    }
  }
}
