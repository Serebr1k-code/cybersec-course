    },
    {
      "path": "/home/student/task/image.png",
      "b64": ""
    },
    {
      "path": "/home/student/task/srnet.py",
      "text": "print('model: SRNet (deep residual, 12 layers)')\nprint('input: 256x256x3')\nprint('decision: STEGO (prob=0.9931)')\n"
    },
    {
      "path": "/home/student/task/extract.py",
      "text": "print('nto{srnet_d33p_d3t3ct}')\n"
    }
  ],
  "tools": {
