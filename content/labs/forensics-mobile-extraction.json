{
 "id": "forensics-mobile-extraction",
 "workdir": "/home/student/task",
 "hostname": "lab",
 "expect": {
  "file": "/home/student/task/found.txt",
  "contains": "nto{andr01d_b4ckup_l34ks_msgst0r3}"
 },
 "fs": [
  {
   "path": "/home/student/task",
   "type": "dir"
  },
  {
   "path": "/home/student/task/apps",
   "type": "dir"
  },
  {
   "path": "/home/student/task/apps/org.thoughtcrime.securesms",
   "type": "dir"
  },
  {
   "path": "/home/student/task/apps/org.thoughtcrime.securesms/databases",
   "type": "dir"
  },
  {
   "path": "/home/student/task/task.md",
   "text": "# Задача: логическое извлечение данных с Android\n\nИзъят разблокированный Android. Через ADB снят логический бэкап `backup.ab`,\nраспакован в каталог `apps/`. Найди в базе мессенджера сообщение с флагом.\n\nШаги:\n1. `adb devices -l` — устройство видно.\n2. `adb shell pm list packages` — найди пакет мессенджера (`org.thoughtcrime.securesms`).\n3. `sqlite3 apps/org.thoughtcrime.securesms/databases/msgstore.db \".tables\"`.\n4. `sqlite3 apps/org.thoughtcrime.securesms/databases/msgstore.db \"SELECT body FROM message\"`.\n5. Сохрани флаг: `sqlite3 apps/org.thoughtcrime.securesms/databases/msgstore.db \"SELECT body FROM message\" | grep nto > found.txt`.\n"
  },
  {
   "path": "/home/student/task/notes.txt",
   "text": "Заметки:\n- Уровни извлечения: Manual < Logical < Filesystem < Physical.\n- `adb backup -all -f backup.ab` требует разблокировки и подтверждения.\n- `abe.jar unpack backup.ab backup.tar` превращает .ab в обычный tar.\n"
  },
  {
   "path": "/home/student/task/backup.ab",
   "b64": "",
   "mode": "644"
  },
  {
   "path": "/home/student/task/apps/org.thoughtcrime.securesms/databases/msgstore.db",
   "b64": "",
   "mode": "644"
  }
 ],
 "tools": {
  "adb": {
   "help": "adb <devices|shell|backup|pull> ... — эмуляция adb",
   "cases": [
    {
     "match": "devices",
     "example": "devices -l",
     "output": "List of devices attached\nR58M12345\tdevice product:beyond1lte model:SM_G973F device:beyond1 transport_id:1\n"
    },
    {
     "match": "pm\\s+list\\s+packages",
     "example": "shell pm list packages",
     "output": "package:com.android.settings\npackage:com.google.android.gms\npackage:org.thoughtcrime.securesms\npackage:com.android.chrome\n"
    },
    {
     "match": "backup",
     "example": "backup -all -f backup.ab",
     "output": "Now unlock your device and confirm the backup operation...\nBackup finished.\n"
    }
   ]
  },
  "abe": {
   "help": "abe.jar <unpack|pack> <backup.ab> [out.tar] — Android Backup Extractor (эмуляция)",
   "cases": [
    {
     "match": "unpack",
     "example": "unpack backup.ab backup.tar",
     "output": "Android Backup Extractor: reading backup.ab\n  header: version=5, compressed=1, encryption=none\n  writing backup.tar (1.2 MiB)\n  apps/org.thoughtcrime.securesms/databases/msgstore.db\n  apps/org.thoughtcrime.securesms/shared_prefs/org.thoughtcrime.securesms_preferences.xml\n  apps/com.android.chrome/app_chrome/Default/History\n"
    }
   ]
  },
  "sqlite3": {
   "help": "sqlite3 <база> [SQL] — эмуляция sqlite3 (вывод захвачен из реального запуска)",
   "cases": [
    {
     "match": "msgstore.*\\.tables",
     "example": "msgstore.db \".tables\"",
     "output": "message\n"
    },
    {
     "match": "msgstore.*message",
     "example": "msgstore.db \"SELECT body FROM message\"",
     "output": "Привет, встречаемся в 18:00?\nДа, ок\ndont share this: nto{andr01d_b4ckup_l34ks_msgst0r3}\n"
    }
   ]
  }
 }
}