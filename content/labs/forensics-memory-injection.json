{
  "id": "forensics-memory-injection",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{m4lf1nd_rwx_sh3llc0d3}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: найти инъекцию в память\n\n`mem.raw` — дамп оперативной памяти. Подозрительный процесс `rundll32.exe`.\n\n1. Ищи RWX-регионы: `vol -f mem.raw windows.malfind`.\n2. Извлеки и карин инъецированный регион: `python3 malfind_carve.py`.\n\nФлаг `nto{...}` — внутри shellcode. Запиши его в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/mem.raw",
      "b64": ""
    },
    {
      "path": "/home/student/task/malfind_carve.py",
      "text": "#!/usr/bin/env python3\n# Extract the injected (RWX) region from a memory dump and carve the payload.\ndata = open(\"mem.raw\", \"rb\").read()\noff = data.find(b\"MZ\")\nprint(\"MZ header at file offset 0x%x\" % off)\nregion = data[off:off + 512]\nopen(\"shellcode.bin\", \"wb\").write(region)\nimport re\nm = re.search(rb\"nto\\{[^}]+\\}\", region)\nprint(\"carved payload string:\", m.group(0).decode() if m else \"not found\")\n"
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (вывод захвачен из реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        },
        {
          "match": "malfind_carve\\.py",
          "example": "python3 malfind_carve.py",
          "output": "MZ header at file offset 0x1400\ncarved payload string: nto{m4lf1nd_rwx_sh3llc0d3}\n"
        }
      ],
      "fallback": "python3: доступно `python3 malfind_carve.py`\n"
    },
    "vol": {
      "help": "vol -f <дамп> <плагин> [--pid N] — Volatility 3",
      "cases": [
        {
          "match": "windows\\.malfind",
          "example": "vol -f mem.raw windows.malfind",
          "output": "PID    Process     Start        End          Protection            Type\n4120   rundll32    0x400000     0x460000     PAGE_EXECUTE_READWRITE Mapped\n4120   rundll32    0x460000     0x462000     PAGE_EXECUTE_READ     Mapped\n712    explorer    0x7ff00000   0x7ff01000   PAGE_EXECUTE_READ     Mapped\n"
        },
        {
          "match": "windows\\.pslist",
          "example": "vol -f mem.raw windows.pslist",
          "output": "PID    PPID   ImageFileName\n4120   812    rundll32.exe\n712    4      explorer.exe\n4      0      System\n"
        }
      ]
    }
  }
}
