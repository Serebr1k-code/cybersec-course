{
  "id": "forensics-python-tooling",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{c4rv3d_z1p_fr0m_d1sk_1m4g3}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: карвинг ZIP\n\n`disk.img` — сырой образ, в котором спрятан ZIP-архив. Найди сигнатуру `PK\\x03\\x04`,\nвырежи архив и прочитай флаг из `flag.txt` внутри.\n"
    },
    {
      "path": "/home/student/task/disk.img",
      "b64": ""
    },
    {
      "path": "/home/student/task/carve.py",
      "text": "import io, zipfile\ndata = open('disk.img', 'rb').read()\nprint('image size :', len(data))\nsig = b'PK\\x03\\x04'\noff = data.find(sig)\nprint('ZIP signature at offset :', hex(off))\ncarved = data[off:]\nz = zipfile.ZipFile(io.BytesIO(carved))\nnames = z.namelist()\nprint('carved archive entries  :', names)\nfor n in names:\n    print('  %s -> %s' % (n, z.read(n).decode('utf-8', 'replace')))\nprint('flag: nto{c4rv3d_z1p_fr0m_d1sk_1m4g3}')\n"
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (вывод захвачен из реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        },
        {
          "match": "carve\\.py",
          "example": "python3 carve.py",
          "output": "image size : 32768\nZIP signature at offset : 0x2000\ncarved archive entries  : ['flag.txt']\n  flag.txt -> nto{c4rv3d_z1p_fr0m_d1sk_1m4g3}\nflag: nto{c4rv3d_z1p_fr0m_d1sk_1m4g3}\n"
        }
      ],
      "fallback": "python3: доступно `python3 carve.py`\n"
    }
  }
}
