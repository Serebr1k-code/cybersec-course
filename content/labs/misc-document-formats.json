{
  "id": "misc-document-formats",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{00xml_1s_4_zip}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: документ — это архив\n\n`report.docx` — обычный Word-документ. Формат OOXML — это zip с XML-частями.\nСреди служебных частей есть скрытые свойства документа.\n\nНайди флаг в свойствах и запиши в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/report.docx",
      "b64": ""
    }
  ],
  "tools": {
    "unzip": {
      "help": "unzip [-l | -p <файл>] <архив> — список/извлечение (эмуляция, вывод захвачен с реального unzip)",
      "cases": [
        {
          "match": "-l\\s+report\\.docx",
          "example": "-l report.docx",
          "output": "Archive:  report.docx\n  Length      Date    Time    Name\n---------  ---------- -----   ----\n      297  2026-10-13 11:55   [Content_Types].xml\n      106  2026-10-13 11:55   _rels/.rels\n      202  2026-10-13 11:55   word/document.xml\n      306  2026-10-13 11:55   docProps/core.xml\n      345  2026-10-13 11:55   docProps/custom.xml\n       70  2026-10-13 11:55   word/media/image1.png\n---------                     -------\n     1326                     6 files\n"
        },
        {
          "match": "-p\\s+report\\.docx\\s+docProps/custom\\.xml",
          "example": "-p report.docx docProps/custom.xml",
          "output": "<?xml version=\"1.0\"?><Properties xmlns=\"http://schemas.openxmlformats.org/officeDocument/2006/custom-properties\" xmlns:vt=\"http://schemas.openxmlformats.org/officeDocument/2006/docPropsVTypes\"><property fmtid=\"{D5CDD505-2E9C-101B-9397-08002B2CF9AE}\" pid=\"2\" name=\"internal_flag\"><vt:lpwstr>nto{00xml_1s_4_zip}</vt:lpwstr></property></Properties>"
        }
      ]
    }
  }
}
