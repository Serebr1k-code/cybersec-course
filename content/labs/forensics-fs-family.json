{
 "id": "forensics-fs-family",
 "workdir": "/home/student/task",
 "hostname": "lab",
 "expect": {
  "file": "/home/student/task/answer.txt",
  "contains": "nto{f4t32_d3l3t3d_clust3r_r3c0v3ry}"
 },
 "fs": [
  {
   "path": "/home/student/task",
   "type": "dir"
  },
  {
   "path": "/home/student/task/task.md",
   "text": "# Задача: SD-карта с FAT32\n\nОбраз `card.img` снят с SD-карты камеры — это FAT32. Восстанови удалённый\n`SECRET.TXT` и найди метку.\n\n1. Загрузочный сектор: `xxd -l 16 card.img` (`MSDOS5.0`).\n2. Тип ФС и кластер: `fsstat card.img`.\n3. Файлы (в т.ч. удалённые): `fls -r card.img`.\n4. Метка: `strings card.img | grep nto > answer.txt`.\n"
  },
  {
   "path": "/home/student/task/card.img",
   "b64": "",
   "mode": "644"
  }
 ],
 "tools": {
  "fsstat": {
   "help": "fsstat <образ> — параметры файловой системы",
   "cases": [
    {
     "match": "card\\.img",
     "example": "card.img",
     "output": "FILE SYSTEM INFORMATION\nFile System Type: FAT32\nOEM Name: MSDOS5.0\nCluster Size: 4096\nTotal Cluster Range: 2 - 2046\n"
    }
   ]
  },
  "fls": {
   "help": "fls [-r] <образ> — список файлов",
   "cases": [
    {
     "match": "card\\.img",
     "example": "-r card.img",
     "output": "r/r * 13: SECRET.TXT (deleted)\nr/r 14: README.TXT\nr/r 15: DCIM/IMG_0001.JPG\n"
    }
   ]
  }
 }
}
