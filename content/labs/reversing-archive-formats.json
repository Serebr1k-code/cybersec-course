      "mode": "644"
    },
    {
      "path": "/home/student/task/sample.zip",
      "b64": "UEsDBAAAAAAAAAAAAAAAAAAAAAAAAAAAAABwYXlsb2FkLmJpbgBjb25maWcuanNvbgBzdGFnZTIuYmluAG50b3thcmNoMXYzX3oxcF9jcnlwdF9yM3Z9AFBLBQYAAAAAAAAAAAAAAAAAAAAAAAA=",
      "mode": "644"
