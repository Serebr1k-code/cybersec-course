{
  "id": "cloud-secrets-manager",
  "workdir": "/home/student/secretsmgr",
  "hostname": "lab",
  "vars": {},
  "expect": {
    "file": "/home/student/secretsmgr/found.txt",
    "contains": "nto{s3cr3ts_m4n4g3r}"
  },
  "fs": [
    {
      "path": "/home/student/secretsmgr",
      "type": "dir"
    },
    {
      "path": "/home/student/secretsmgr/task.md",
      "text": "# Задача: secrets manager\n\nПеречисли секреты и прочитай тот, что содержит флаг.\n\nИнструмент: `aws` (эмуляция).\n"
    },
    {
      "path": "/home/student/secretsmgr/notes.md",
      "text": "Заметки\n------\n- Secrets Manager/Key Vault/KMS — централизованные секреты.\n- Избыточный GetSecretValue = массовая утечка.\n"
    }
  ],
  "tools": {
    "aws": {
      "help": "aws secretsmanager <list-secrets|get-secret-value> — AWS CLI (эмуляция)",
      "cases": [
        {
          "match": "list-secrets",
          "example": "aws secretsmanager list-secrets",
          "output": "{\"SecretList\": [\n  {\"Name\": \"prod/db\"},\n  {\"Name\": \"prod/app\"},\n  {\"Name\": \"prod/legacy\"}\n]}\n"
        },
        {
          "match": "get-secret-value",
          "example": "aws secretsmanager get-secret-value --secret-id prod/app",
          "output": "{\"Name\": \"prod/app\", \"SecretString\": \"nto{s3cr3ts_m4n4g3r}\"}\n"
        }
      ],
      "fallback": "aws: (эмуляция) такой вызов не захвачен. Попробуй:\n  aws secretsmanager list-secrets\n  aws secretsmanager get-secret-value --secret-id prod/app\n"
    }
  }
}
