{
  "id": "reversing-advanced-debugging",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/answer.txt",
    "contains": "calls=2"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: логирование точкой останова через скрипт\n\nGDB-скрипт с `commands ... silent ... printf ... continue` печатает состояние\nна каждом срабатывании точки останова, не останавливая программу.\n\n1. `cat trace.gdb` — посмотри скрипт.\n2. `gdb -batch -x trace.gdb watchme` — запусти.\n3. Посчитай, сколько раз вызвана `bump()`.\n\nЗапиши в `answer.txt` строку вида `calls=<число>` и набери `check`.\n"
    },
    {
      "path": "/home/student/task/watchme",
      "b64": "",
      "mode": "755"
    },
    {
      "path": "/home/student/task/trace.gdb",
      "text": "set pagination off\nbreak bump\ncommands\nsilent\nprintf \"bump called, counter=%d\\n\", counter\ncontinue\nend\nrun\n"
    }
  ],
  "tools": {
    "gdb": {
      "help": "gdb -batch -x <скрипт> <файл> — отладчик (вывод реального gdb)",
      "cases": [
        {
          "match": "trace\\.gdb",
          "example": "gdb -batch -x trace.gdb watchme",
          "output": "Breakpoint 1 at 0x4010b8: file watchme.c, line 5.\nbump called, counter=0\nbump called, counter=4\ndone\n[Inferior 1 (process 285704) exited normally]\n"
        }
      ],
      "fallback": "gdb: запусти gdb -batch -x trace.gdb watchme.\n"
    }
  }
}
