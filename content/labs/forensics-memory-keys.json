{
  "id": "forensics-memory-keys",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{ls4ss_s3cr3ts_1n_r4m}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: секреты из памяти\n\n`mem_keys.raw` — дамп памяти. Нужно достать учётные данные.\n\n1. Локальные хеши: `vol -f mem_keys.raw windows.hashdump`.\n2. LSA secrets: `vol -f mem_keys.raw windows.lsadump`.\n3. Альтернатива: `pypykatz lsa minidump lsass.dmp`.\n\nФлаг `nto{...}` — это найденный пароль службы. Запиши его в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/mem_keys.raw",
      "b64": ""
    }
  ],
  "tools": {
    "vol": {
      "help": "vol -f <дамп> <плагин> — Volatility 3",
      "cases": [
        {
          "match": "windows\\.hashdump",
          "example": "vol -f mem_keys.raw windows.hashdump",
          "output": "Administrator:500:aad3b435b51404eeaad3b435b51404ee:31d6cfe0d16ae931b73c59d7e0c089c0:::\nbob:1001:aad3b435b51404eeaad3b435b51404ee:8846f7eaee8fb117ad06bdd830b7586c:::\n"
        },
        {
          "match": "windows\\.lsadump",
          "example": "vol -f mem_keys.raw windows.lsadump",
          "output": "[*] DefaultPassword = nto{ls4ss_s3cr3ts_1n_r4m}\n[*] DPAPI_SYSTEM = 01000000f3e3a1b2...\n[*] NL$KM = a1b2c3d4e5f6...\n"
        }
      ]
    },
    "pypykatz": {
      "help": "pypykatz lsa minidump <файл> — парсинг LSASS",
      "cases": [
        {
          "match": "minidump",
          "example": "pypykatz lsa minidump lsass.dmp",
          "output": "== LogonSession ==\nusername: bob\ndomain: DESKTOP\n== MSV ==\nNT: 8846f7eaee8fb117ad06bdd830b7586c\n== WDIGEST [0] ==\npassword: nto{ls4ss_s3cr3ts_1n_r4m}\n"
        }
      ]
    }
  }
}
