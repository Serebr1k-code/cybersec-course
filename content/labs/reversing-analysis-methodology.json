{
  "id": "reversing-analysis-methodology",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/answer.txt",
    "contains": "not stripped"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: быстрый триаж неизвестного ELF\n\nПеред глубоким анализом собери паспорт файла: тип, защиту от чтения символов,\nархитектуру и строки.\n\n1. `file crackme`\n2. `readelf --file-header crackme`\n3. `nm crackme` (есть ли символы?)\n\nОтветь на вопрос: **вырезана ли таблица символов** (stripped)?\nЗапиши ответ как `stripped` или `not stripped` в `answer.txt` и набери `check`.\n"
    },
    {
      "path": "/home/student/task/crackme",
      "b64": "",
      "mode": "755"
    }
  ],
  "tools": {
    "nm": {
      "help": "nm <файл> — таблица символов (вывод реального nm)",
      "cases": [
        {
          "match": "\\S",
          "example": "nm <файл>",
          "output": "0000000000403000 R __bss_start\n0000000000403000 R _edata\n0000000000403000 R _end\n0000000000401000 T _start\n0000000000401185 T main\n00000000004010cc t put\n0000000000401103 t putflag\n000000000040107d t scmp\n000000000040104e t slen\n000000000040101e t sys\n"
        }
      ],
      "fallback": "0000000000403000 R __bss_start\n0000000000403000 R _edata\n0000000000403000 R _end\n0000000000401000 T _start\n0000000000401185 T main\n00000000004010cc t put\n0000000000401103 t putflag\n000000000040107d t scmp\n000000000040104e t slen\n000000000040101e t sys\n"
    },
    "readelf": {
      "help": "readelf --file-header <файл> — заголовок ELF",
      "cases": [
        {
          "match": "file-header",
          "example": "readelf --file-header crackme",
          "output": "ELF Header:\n  Magic:   7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00 \n  Class:                             ELF64\n  Data:                              2's complement, little endian\n  Version:                           1 (current)\n  OS/ABI:                            UNIX - System V\n  ABI Version:                       0\n  Type:                              EXEC (Executable file)\n  Machine:                           Advanced Micro Devices X86-64\n  Version:                           0x1\n  Entry point address:               0x401000\n  Start of program headers:          64 (bytes into file)\n  Start of section headers:          9024 (bytes into file)\n  Flags:                             0x0\n  Size of this header:               64 (bytes)\n  Size of program headers:           56 (bytes)\n  Number of program headers:         7\n  Size of section headers:           64 (bytes)\n  Number of section headers:         10\n  Section header string table index: 9\n"
        }
      ],
      "fallback": "ELF Header:\n  Magic:   7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00 \n  Class:                             ELF64\n  Data:                              2's complement, little endian\n  Version:                           1 (current)\n  OS/ABI:                            UNIX - System V\n  ABI Version:                       0\n  Type:                              EXEC (Executable file)\n  Machine:                           Advanced Micro Devices X86-64\n  Version:                           0x1\n  Entry point address:               0x401000\n  Start of program headers:          64 (bytes into file)\n  Start of section headers:          9024 (bytes into file)\n  Flags:                             0x0\n  Size of this header:               64 (bytes)\n  Size of program headers:           56 (bytes)\n  Number of program headers:         7\n  Size of section headers:           64 (bytes)\n  Number of section headers:         10\n  Section header string table index: 9\n"
    }
