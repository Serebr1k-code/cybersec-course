{
  "id": "mobile-ios-ipa-analysis",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{1pa_1ns1d3_0ut}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: анализ IPA\n\n`app.ipa` — iOS-приложение. Внутри есть `Payload/Vanta.app` с бинарниками\nи конфигом. Часть файлов сохранена без сжатия — это классическая ошибка\nсборки, из-за которой секреты видны через `strings`.\n\nНайди флаг и запиши в `found.txt`. (`unzip -l`, `unzip -p`, `strings`.)\n"
    },
    {
      "path": "/home/student/task/app.ipa",
      "b64": ""
    }
  ],
  "tools": {
    "unzip": {
      "help": "unzip [-l | -p <файл>] <архив> — список/извлечение (эмуляция, вывод захвачен с реального unzip)",
      "cases": [
        {
          "match": "-l\\s+app\\.ipa",
          "example": "-l app.ipa",
          "output": "Archive:  app.ipa\n  Length      Date    Time    Name\n---------  ---------- -----   ----\n      265  2026-10-13 11:50   Payload/Vanta.app/Info.plist\n       90  2026-10-13 11:50   Payload/Vanta.app/Vanta\n      116  2026-10-13 11:50   Payload/Vanta.app/embedded.mobileprovision\n       57  2026-10-13 11:50   Payload/Vanta.app/Frameworks/VantaKit.framework/VantaKit\n       60  2026-10-13 11:50   Payload/Vanta.app/config.json\n---------                     -------\n      588                     5 files\n"
        },
        {
          "match": "-p\\s+app\\.ipa\\s+Payload/Vanta\\.app/config\\.json",
          "example": "-p app.ipa Payload/Vanta.app/config.json",
          "output": "{\"endpoint\":\"https://api.vanta.local\",\"pin\":\"sha256/DECOY\"}\n"
        }
      ]
    }
  }
}
