    },
    {
      "path": "/home/student/task/sar.json",
      "text": "{\n  \"satellite\": \"Sentinel-1B\",\n  \"mode\": \"IW\",\n  \"polarization\": \"VV+VH\",\n  \"orbit\": \"descending\",\n  \"coherence\": 0.21,\n  \"x_note\": \"nto{s4r_c0h3r3nc3_ch4ng3}\"\n}\n"
