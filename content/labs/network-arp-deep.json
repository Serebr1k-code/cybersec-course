      "b64": "1MOyoQIABAAAAAAAAAAAAP//AAABAAAAzVDOamykDAAqAAAAKgAAAAIAAAAABQIAAN6tAQgGAAEIAAYEAAICAADerQEKAAABAgAAAAAFCgAABc1QzmpfpQwAKgAAACoAAAACAAAAAAUCAADerQEIBgABCAAGBAACAgAA3q0BCgAAAQIAAAAABQoAAAXNUM5qOqYMACoAAAAqAAAAAgAA3q0BAgAAAAAFCAYAAQgABgQAAQIAAAAABQoAAAUAAAAAAAAKAAAB",
      "mode": "644"
