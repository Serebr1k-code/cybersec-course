{
  "id": "osint-image-reverse-deep",
  "hostname": "lab",
  "workdir": "/home/student/task",
  "expect": {
    "file": "/home/student/task/answer.txt",
    "contains": "nto{f4c3_cr0p_4ttr1but3d}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Практика: деанон по кропам\n\nЕсть `street.jpg`, `crop_face.jpg`, `crop_sign.jpg`. Нужно связать фото с аккаунтами и местом.\n\n1. Метаданные: `exiftool street.jpg`.\n2. Поиск по лицу: `curl -s -X POST \"https://pimeyes.com/api/search\" -F \"image=@crop_face.jpg\" > face.json`\n3. `jq -r '.results[].profile_url' face.json`\n4. Поиск по вывеске: `curl -s \"https://serpapi.com/search?engine=google_lens&url=crop_sign.jpg\" > lens.json`\n5. Открой подтверждённый профиль: `curl -s \"https://vk.com/ivan_petrov\" > vk.html`; `grep nto vk.html`\n6. Запиши `nto{...}` в `answer.txt`, набери `check`.\n"
    },
    {
      "path": "/home/student/task/street.jpg",
      "b64": "",
      "mode": "644"
    },
    {
      "path": "/home/student/task/crop_face.jpg",
      "b64": "",
      "mode": "644"
    },
    {
      "path": "/home/student/task/crop_sign.jpg",
      "b64": "",
      "mode": "644"
    }
  ],
  "tools": {
    "exiftool": {
      "help": "exiftool <файл> — метаданные (эмуляция)",
      "cases": [
        {
          "match": "street\\.jpg",
          "example": "street.jpg",
          "output": "======== street.jpg\nCamera Model Name               : iPhone 12\nDate/Time Original              : 2023:05:12 14:22:03\nGPS Position                    : 55 deg 45' 21.00\" N, 37 deg 37' 4.00\" E\n    1 image files read\n"
        }
      ],
      "fallback": "exiftool: в этой лабе есть street.jpg, crop_face.jpg, crop_sign.jpg.\n"
    },
    "curl": {
      "help": "curl [-s] <URL> — PimEyes / Google Lens / профиль (эмуляция)",
      "cases": [
        {
          "match": "pimeyes\\.com",
          "example": "curl -s -X POST https://pimeyes.com/api/search -F image=@crop_face.jpg",
          "output": "{\"results\": [\n {\"profile_url\": \"https://instagram.com/ivan_p\", \"confidence\": 0.91},\n {\"profile_url\": \"https://vk.com/ivan_petrov\", \"confidence\": 0.95},\n {\"profile_url\": \"https://forum.example.com/user/ipetrov\", \"confidence\": 0.72}\n]}\n"
        },
        {
          "match": "serpapi\\.com|google_lens",
          "example": "curl -s \"https://serpapi.com/search?engine=google_lens&url=crop_sign.jpg\"",
          "output": "{\"search_metadata\": {\"status\": \"Success\"},\n \"visual_matches\": [\n  {\"title\": \"кафе «Хлеб», ул. Тверская 12\", \"link\": \"https://maps.example.com/hleb\"}\n]}\n"
        },
        {
          "match": "vk\\.com/ivan_petrov",
          "example": "curl -s https://vk.com/ivan_petrov",
          "output": "<html><head><title>Иван Петров</title></head><body>\n<p>Москва. dev, PGP 1A2B3C4D5E6F7A8B</p>\n<p>verified: nto{f4c3_cr0p_4ttr1but3d}</p>\n</body></html>\n"
        }
      ],
      "fallback": "curl: в этой лабе доступны pimeyes.com/api/search, serpapi.com и vk.com/ivan_petrov.\n"
    },
    "jq": {
      "help": "jq [-r] <фильтр> <файл> — разбор JSON (эмуляция)",
      "cases": [
        {
          "match": "profile_url|results|confidence",
          "example": "jq -r '.results[].profile_url' face.json",
          "output": "https://instagram.com/ivan_p\nhttps://vk.com/ivan_petrov\nhttps://forum.example.com/user/ipetrov\n"
        }
      ],
      "fallback": "jq: в этой лабе поддержан фильтр по .results[].profile_url.\n"
    }
  }
}
