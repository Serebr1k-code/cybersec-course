{
  "id": "mobile-native-so-deep",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{n4t1v3_s0_r3v3rs1ng}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: нативная библиотека\n\nВ приложении есть `libvanta.so` — нативный код, который проверяет лицензию.\nРазбери его и найди строку-флаг. Запиши флаг в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/libvanta.so",
      "b64": ""
    }
  ],
  "tools": {
    "nm": {
      "help": "nm [-D] <файл> — таблица символов",
      "cases": [
        {
          "match": "-D.*libvanta\\.so",
          "output": "000000000000100d T check\n0000000000001000 T expected_flag\n"
        }
      ],
      "fallback": "nm: доступно `nm -D libvanta.so`\n"
    },
    "readelf": {
      "help": "readelf -h <файл> — заголовок ELF",
      "cases": [
        {
          "match": "-h.*libvanta\\.so",
          "output": "ELF Header:\n  Magic:   7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00\n  Class:                             ELF64\n  Type:                              DYN (Shared object file)\n  Machine:                           Advanced Micro Devices X86-64\n"
        }
      ],
      "fallback": "readelf: доступно `readelf -h libvanta.so`\n"
    },
    "objdump": {
      "help": "objdump -d <файл> — дизассемблирование",
      "cases": [
        {
          "match": "-d.*libvanta\\.so",
          "output": "\nlibvanta.so:     file format elf64-x86-64\n\nDisassembly of section .text:\n\n0000000000001000 <expected_flag>:\n    1000:\t55                   \tpush   %rbp\n    1004:\t48 8d 05 f5 0f 00 00 \tlea    0xff5(%rip),%rax        # 2000 <check+0xff3>\n    100c:\tc3                   \tret\n"
        }
      ],
      "fallback": "objdump: доступно `objdump -d libvanta.so`\n"
    }
  }
}
