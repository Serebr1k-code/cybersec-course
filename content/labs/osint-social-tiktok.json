{
  "id": "osint-social-tiktok",
  "hostname": "lab",
  "workdir": "/home/student/task",
  "expect": {
    "file": "/home/student/task/answer.txt",
    "contains": "nto{t1kt0k_g30_v14_5t0r3_5ign}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Практика: геолокация по видео TikTok\n\nЕсть `clip.mp4` и кадр `frame_007.png`.\n\n1. OEmbed-метаданные: `curl -s \"https://www.tiktok.com/oembed?url=https://www.tiktok.com/@vintage.msk/video/7312345678901234567\" > tt.json`\n2. `jq '{author_name,title}' tt.json`\n3. OCR кадра: `tesseract frame_007.png -` — читай вывеску магазина.\n4. Метаданные клипа: `exiftool clip.mp4`.\n5. Маркер `nto{...}` напечатан на вывеске в кадре — запиши в `answer.txt`, набери `check`.\n"
    },
    {
      "path": "/home/student/task/frame_007.png",
      "b64": "",
      "mode": "644"
    },
    {
      "path": "/home/student/task/clip.mp4",
      "b64": "AAAAGGZ0eXBtcDQyAAAAAG1wNDJpc29tAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==",
      "mode": "644"
    }
  ],
  "tools": {
    "curl": {
      "help": "curl [-s] <URL> — TikTok oEmbed (эмуляция)",
      "cases": [
        {
          "match": "tiktok\\.com/oembed",
          "example": "curl -s \"https://www.tiktok.com/oembed?url=https://www.tiktok.com/@vintage.msk/video/...\"",
          "output": "{\"author_name\": \"vintage.msk\", \"author_url\": \"https://www.tiktok.com/@vintage.msk\", \"title\": \"new store opening #moscow\", \"provider_name\": \"TikTok\"}\n"
        }
      ],
      "fallback": "curl: в этой лабе доступен только tiktok.com/oembed.\n"
    },
    "jq": {
      "help": "jq [-r] <фильтр> <файл> — разбор JSON (эмуляция)",
      "cases": [
        {
          "match": "author_name|title",
          "example": "jq '{author_name,title}' tt.json",
          "output": "{\n  \"author_name\": \"vintage.msk\",\n  \"title\": \"new store opening #moscow\"\n}\n"
        }
      ],
      "fallback": "jq: в этой лабе поддержан фильтр по author_name/title.\n"
    },
    "tesseract": {
      "help": "tesseract <файл> <вывод> — OCR (эмуляция)",
      "cases": [
        {
          "match": "frame_007",
          "example": "frame_007.png -",
          "output": "Vintage Store\nul. Lenina 5\nnto{t1kt0k_g30_v14_5t0r3_5ign}\n"
        }
      ],
      "fallback": "tesseract: в этой лабе распознаётся только frame_007.png.\n"
    },
    "exiftool": {
      "help": "exiftool <файл> — метаданные (эмуляция)",
      "cases": [
        {
          "match": "clip\\.mp4",
          "example": "clip.mp4",
          "output": "======== clip.mp4\nFile Type                       : MP4\nMIME Type                       : video/mp4\nCreate Date                     : 2024:02:18 19:05:11\nDuration                        : 14.28 s\n    1 image files read\n"
        }
      ],
      "fallback": "exiftool: в этой лабе есть только clip.mp4.\n"
    }
  }
}
