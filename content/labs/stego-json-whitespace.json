{
  "id": "stego-json-whitespace",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{json_ws_b1t5}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: пробелы в JSON\n\n`config.json` валиден, но отступы в начале строк кодируют сообщение\n(пробел = 0, таб = 1).\n\n1. `xxd -l 48 config.json`.\n2. `python3 wsjson.py` — извлечение бит.\n3. `python3 wsjson.py | grep nto > found.txt`.\n"
    },
    {
      "path": "/home/student/task/config.json",
      "b64": ""
    },
    {
      "path": "/home/student/task/wsjson.py",
      "text": "lines = open('config.json', encoding='utf-8').read().split('\\n')\nbits = ''\nfor ln in lines:\n    if ln[:1] in (' ', '\\t'):\n        bits += '0' if ln[0] == ' ' else '1'\nmsg = ''.join(chr(int(bits[i:i+8], 2)) for i in range(0, len(bits)-7, 8))\nprint(msg)\n"
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция, вывод реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        },
        {
          "match": "wsjson\\.py",
          "example": "python3 wsjson.py",
          "output": "nto{json_ws_b1t5}\n"
        }
      ]
    }
  }
}
