   "path": "/home/student/task/task.md",
   "text": "# Задача: атака Винера\n\nRSA с малым секретным показателем `d` (и большим `e`). Разложи `e/n` в цепную дробь,\nперебери подходящие дроби и восстанови `d`, затем расшифруй `c`. Флаг — в `found.txt`.\n"
  },
  {
   "path": "/home/student/task/n.txt",
   "text": "\n"
  },
  {
   "path": "/home/student/task/e.txt",
   "text": "\n"
  },
  {
   "path": "/home/student/task/c.txt",
   "text": "\n"
  },
  {
   "path": "/home/student/task/wiener.py",
   "text": "# Wiener's attack: recover small d from the continued-fraction convergents of e/n.\nn = \ne = \nc = \nimport math\ndef contfrac(a, b):\n    cf = []\n    while b:\n        cf.append(a // b); a, b = b, a % b\n    return cf\ndef convergents(cf):\n    p0, q0, p1, q1 = 0, 1, 1, 0\n    for a in cf:\n        p0, p1 = p1, a*p1 + p0\n        q0, q1 = q1, a*q1 + q0\n        yield p1, q1\nfor k, d in convergents(contfrac(e, n)):\n    if k == 0 or (e*d - 1) % k:\n        continue\n    phi = (e*d - 1) // k\n    s = n - phi + 1\n    disc = s*s - 4*n\n    if disc < 0: continue\n    t = math.isqrt(disc)\n    if t*t != disc: continue\n    if (s + t) % 2: continue\n    p = (s + t)//2; q = (s - t)//2\n    if p*q == n:\n        m = pow(c, d, n)\n        print(\"recovered d =\", d)\n        print(\"plaintext   =\", m.to_bytes((m.bit_length()+7)//8, 'big').decode())\n        break\n"
  }
 ],
