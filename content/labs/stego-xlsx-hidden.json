{
  "id": "stego-xlsx-hidden",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{xlsx_veryhidden_sheet}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: veryHidden лист в XLSX\n\n`report.xlsx` — книга OOXML. Один лист скрыт как veryHidden.\n\n1. `unzip -l report.xlsx`.\n2. `python3 xlsx.py` — имя скрытого листа.\n3. `python3 xlsx.py | grep nto > found.txt`.\n"
    },
    {
      "path": "/home/student/task/report.xlsx",
      "b64": ""
    },
    {
      "path": "/home/student/task/xlsx.py",
      "text": "import zipfile, re\nz = zipfile.ZipFile('report.xlsx')\nwb = z.read('xl/workbook.xml').decode()\nfor m in re.finditer(r'name=\"([^\"]+)\"[^>]*state=\"veryHidden\"', wb):\n    print(m.group(1))\n"
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция, вывод реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        },
        {
          "match": "xlsx\\.py",
          "example": "python3 xlsx.py",
          "output": "nto{xlsx_veryhidden_sheet}\n"
        }
      ]
    }
  }
}
