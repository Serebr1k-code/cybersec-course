{
  "id": "stego-odf",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{odf_meta_field}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: пользовательское поле в meta.xml\n\n`doc.odt` — ODF-документ. В `meta.xml` есть base64 в meta:user-defined.\n\n1. `unzip -l doc.odt`.\n2. `python3 odf.py` — декодирование.\n3. `python3 odf.py | grep nto > found.txt`.\n"
    },
    {
      "path": "/home/student/task/doc.odt",
      "b64": ""
    },
    {
      "path": "/home/student/task/odf.py",
      "text": "import zipfile, base64, re\nz = zipfile.ZipFile('doc.odt')\nmeta = z.read('meta.xml').decode()\nm = re.search(r'meta:user-defined[^>]*>([^<]+)<', meta)\nprint(base64.b64decode(m.group(1)).decode())\n"
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция, вывод реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        },
        {
          "match": "odf\\.py",
          "example": "python3 odf.py",
          "output": "nto{odf_meta_field}\n"
        }
      ]
    }
  }
}
