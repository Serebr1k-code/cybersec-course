{
  "id": "reversing-drm",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{k3yg3n_crc32_x0r_dr34m}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: сгенерировать лицензионный ключ\n\n`liccheck` проверяет ключ для имени `alice`. Криптография самодельная:\nключ = `CRC32(name) XOR 0xDEADBEEF`. Константа вшита в бинарник.\n\n1. `objdump -d liccheck` — найди инструкцию `xor` с `0xdeadbeef`.\n2. `python3 keygen.py` — готовый генератор ключа.\n3. `liccheck <ключ>` — проверь лицензию и забери флаг.\n4. Запиши флаг в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/liccheck",
      "b64": "",
      "mode": "755"
    },
    {
      "path": "/home/student/task/keygen.py",
      "text": "import zlib\ndef keygen(n): return \"%08X\" % ((zlib.crc32(n.encode()) & 0xffffffff) ^ 0xDEADBEEF)\nfor n in (\"alice\",\"bob\"):\n    print(n, \"->\", keygen(n))\n"
    }
  ],
  "tools": {
    "objdump": {
      "help": "objdump -d <файл>",
      "cases": [
        {
          "match": "-d",
          "output": "\n/tmp/labgen/fx/liccheck:     file format elf64-x86-64\n\n\nDisassembly of section .text:\n\n0000000000401000 <_start>:\n  401000:\t55                   \tpush   %rbp\n  401001:\t48 89 e5             \tmov    %rsp,%rbp\n  401004:\tb8 ef be ad de       \tmov    $0xdeadbeef,%eax\n  401009:\t31 c0                \txor    %eax,%eax\n  40100b:\t48 c7 c0 3c 00 00 00 \tmov    $0x3c,%rax\n  401012:\t48 31 ff             \txor    %rdi,%rdi\n  401015:\t0f 05                \tsyscall\n  401017:\t90                   \tnop\n  401018:\t5d                   \tpop    %rbp\n  401019:\tc3                   \tret\n",
          "example": "objdump -d liccheck"
        }
      ]
    },
    "readelf": {
      "help": "readelf <опция> <файл>",
      "cases": [
        {
          "match": "file-header|--file-header",
          "output": "ELF Header:\n  Magic:   7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00 \n  Class:                             ELF64\n  Data:                              2's complement, little endian\n  Version:                           1 (current)\n  OS/ABI:                            UNIX - System V\n  ABI Version:                       0\n  Type:                              EXEC (Executable file)\n  Machine:                           Advanced Micro Devices X86-64\n  Version:                           0x1\n  Entry point address:               0x401000\n  Start of program headers:          64 (bytes into file)\n  Start of section headers:          8600 (bytes into file)\n  Flags:                             0x0\n  Size of this header:               64 (bytes)\n  Size of program headers:           56 (bytes)\n  Number of program headers:         7\n  Size of section headers:           64 (bytes)\n  Number of section headers:         9\n  Section header string table index: 8\n",
          "example": "readelf --file-header liccheck"
        }
      ]
    },
    "python3": {
      "help": "python3 <скрипт>",
      "cases": [
        {
          "match": "keygen",
          "output": "alice -> F92302A8\nbob -> 2B660FAF\n",
          "example": "python3 keygen.py"
        }
      ]
    },
    "liccheck": {
      "help": "liccheck <ключ> — проверка лицензии",
      "cases": [
        {
          "match": "F92302A8",
          "output": "license OK for alice\nexp = 2027-01-01\nflag: nto{k3yg3n_crc32_x0r_dr34m}\n"
        }
      ],
      "fallback": "license invalid: wrong key\n"
    }
  }
}