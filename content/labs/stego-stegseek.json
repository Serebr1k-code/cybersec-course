{
  "id": "stego-stegseek",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{st3gs33k_cr4cks_1n_s3c0nds}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: перебор пароля через stegseek\n\n`hidden.jpg` — steghide-контейнер с паролем из словаря. Подбери пароль\nпо `steg_wordlist.txt` и извлеки секрет в `found.txt`.\n\nИнструмент: `stegseek hidden.jpg steg_wordlist.txt -xf out.txt`.\n"
    },
    {
      "path": "/home/student/task/notes.txt",
      "text": "Заметки\n-------\n- stegseek перебирает словарь за секунды (использует steghide-совместимый движок).\n- Ключ `-xf <файл>` задаёт, куда писать извлечённые данные.\n- Пароль — одно из слов в словаре.\n"
    },
    {
      "path": "/home/student/task/hidden.jpg",
      "b64": ""
    },
    {
      "path": "/home/student/task/steg_wordlist.txt",
      "text": "123456\npassword\nsunshine\nnto{st3gs33k_cr4cks_1n_s3c0nds}\nqwerty\n"
    }
  ],
  "tools": {
    "stegseek": {
      "help": "stegseek <jpeg> <словарь> [-xf <выход>] — перебор steghide-пароля (эмуляция)",
      "cases": [
        {
          "match": "steg_wordlist",
          "example": "hidden.jpg steg_wordlist.txt -xf out.txt",
          "output": "StegSeek 0.6 - https://github.com/RickdeJager/StegSeek\n\n[i] Found passphrase: \"sunshine\"\n[i] Original filename: \"secret.txt\".\n[i] Extracting to \"out.txt\".\nnto{st3gs33k_cr4cks_1n_s3c0nds}\n",
          "writes": [
            "-xf"
          ]
        }
      ]
    }
  }
}
