{
  "id": "reversing-static-tools",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{str1ngs_1s_th3_f1rst_st3p}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: статический разбор ELF\n\nВ каталоге лежит `sample` — небольшой ELF. Флаг зашит внутрь.\n\n1. `file sample` — что это за файл.\n2. `strings sample` — печатаемые строки (флаг тоже там).\n3. `nm sample`, `objdump -d sample` — символы и дизассемблер.\n\nНайденный флаг запиши в `found.txt` и набери `check`.\n"
    },
    {
      "path": "/home/student/task/sample",
      "b64": "",
      "mode": "755"
    }
  ],
  "tools": {
    "nm": {
      "help": "nm <файл> — таблица символов",
      "cases": [
        {
          "match": "\\S",
          "example": "nm sample",
          "output": "0000000000401050 t .nope\n000000000040105e t .pr\n0000000000403000 R __bss_start\n0000000000403000 R _edata\n0000000000403000 R _end\n0000000000401021 T _start\n0000000000402007 r flag\n0000000000402027 r nope\n0000000000402000 r password\n0000000000401000 t strcmp\n"
        }
      ]
    },
    "objdump": {
      "help": "objdump -d <файл> — дизассемблер",
      "cases": [
        {
          "match": "-d",
          "example": "objdump -d sample",
          "output": "\nsample:     file format elf64-x86-64\n\n\nDisassembly of section .text:\n\n0000000000401000 <strcmp>:\n  401000:\t31 c0                \txor    %eax,%eax\n  401002:\t0f b6 0f             \tmovzbl (%rdi),%ecx\n  401005:\t0f b6 16             \tmovzbl (%rsi),%edx\n  401008:\t38 d1                \tcmp    %dl,%cl\n  40100a:\t75 0c                \tjne    401018 <strcmp+0x18>\n  40100c:\t84 c9                \ttest   %cl,%cl\n  40100e:\t74 0e                \tje     40101e <strcmp+0x1e>\n  401010:\t48 ff c7             \tinc    %rdi\n  401013:\t48 ff c6             \tinc    %rsi\n  401016:\teb ea                \tjmp    401002 <strcmp+0x2>\n  401018:\tb8 01 00 00 00       \tmov    $0x1,%eax\n  40101d:\tc3                   \tret\n  40101e:\t31 c0                \txor    %eax,%eax\n  401020:\tc3                   \tret\n\n0000000000401021 <_start>:\n  401021:\t48 8b 04 24          \tmov    (%rsp),%rax\n  401025:\t48 83 f8 02          \tcmp    $0x2,%rax\n  401029:\t7c 25                \tjl     401050 <.nope>\n  40102b:\t48 8b 74 24 10       \tmov    0x10(%rsp),%rsi\n  401030:\t48 8d 3d c9 0f 00 00 \tlea    0xfc9(%rip),%rdi        # 402000 <password>\n  401037:\te8 c4 ff ff ff       \tcall   401000 <strcmp>\n  40103c:\t85 c0                \ttest   %eax,%eax\n  40103e:\t75 10                \tjne    401050 <.nope>\n  401040:\t48 8d 35 c0 0f 00 00 \tlea    0xfc0(%rip),%rsi        # 402007 <flag>\n  401047:\t48 c7 c2 1f 00 00 00 \tmov    $0x1f,%rdx\n  40104e:\teb 0e                \tjmp    40105e <.pr>\n\n0000000000401050 <.nope>:\n  401050:\t48 8d 35 d0 0f 00 00 \tlea    0xfd0(%rip),%rsi        # 402027 <nope>\n  401057:\t48 c7 c2 05 00 00 00 \tmov    $0x5,%rdx\n\n000000000040105e <.pr>:\n  40105e:\t48 c7 c0 01 00 00 00 \tmov    $0x1,%rax\n  401065:\t48 c7 c7 01 00 00 00 \tmov    $0x1,%rdi\n  40106c:\t0f 05                \tsyscall\n  40106e:\t48 c7 c0 3c 00 00 00 \tmov    $0x3c,%rax\n  401075:\t48 31 ff             \txor    %rdi,%rdi\n  401078:\t0f 05                \tsyscall\n"
        }
      ]
    },
    "readelf": {
      "help": "readelf <опция> <файл>",
      "cases": [
        {
          "match": "file-header|-h",
          "example": "readelf -h sample",
          "output": "ELF Header:\n  Magic:   7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00 \n  Class:                             ELF64\n  Data:                              2's complement, little endian\n  Version:                           1 (current)\n  OS/ABI:                            UNIX - System V\n  ABI Version:                       0\n  Type:                              EXEC (Executable file)\n  Machine:                           Advanced Micro Devices X86-64\n  Version:                           0x1\n  Entry point address:               0x401021\n  Start of program headers:          64 (bytes into file)\n  Start of section headers:          8728 (bytes into file)\n  Flags:                             0x0\n  Size of this header:               64 (bytes)\n  Size of program headers:           56 (bytes)\n  Number of program headers:         6\n  Size of section headers:           64 (bytes)\n  Number of section headers:         8\n  Section header string table index: 7\n"
        },
        {
          "match": "section-headers|-S",
          "example": "readelf -S sample",
          "output": "There are 8 section headers, starting at offset 0x2218:\n\nSection Headers:\n  [Nr] Name              Type             Address           Offset\n       Size              EntSize          Flags  Link  Info  Align\n  [ 0]                   NULL             0000000000000000  00000000\n       0000000000000000  0000000000000000           0     0     0\n  [ 1] .note.gnu.bu[...] NOTE             0000000000400190  00000190\n       0000000000000024  0000000000000000   A       0     0     4\n  [ 2] .text             PROGBITS         0000000000401000  00001000\n       000000000000007a  0000000000000000  AX       0     0     1\n  [ 3] .rodata           PROGBITS         0000000000402000  00002000\n       000000000000002d  0000000000000000   A       0     0     1\n  [ 4] .note.gnu.pr[...] NOTE             0000000000402030  00002030\n       0000000000000030  0000000000000000   A       0     0     8\n  [ 5] .symtab           SYMTAB           0000000000000000  00002060\n       0000000000000120  0000000000000018           6     8     8\n  [ 6] .strtab           STRTAB           0000000000000000  00002180\n       0000000000000043  0000000000000000           0     0     1\n  [ 7] .shstrtab         STRTAB           0000000000000000  000021c3\n       000000000000004f  0000000000000000           0     0     1\nKey to Flags:\n  W (write), A (alloc), X (execute), M (merge), S (strings), I (info),\n  L (link order), O (extra OS processing required), G (group), T (TLS),\n  C (compressed), x (unknown), o (OS specific), E (exclude),\n  D (mbind), l (large), p (processor specific)\n"
        }
      ]
    }
  }
}
