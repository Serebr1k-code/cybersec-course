{
  "id": "osint-recon-ng",
  "hostname": "lab",
  "workdir": "/home/student/task",
  "expect": {
    "file": "/home/student/task/answer.txt",
    "contains": "nto{r3c0n_ng_gr4ph_1s_sql1t3}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Практика: запросить базу recon-ng\n\nrecon-ng хранит результаты workspace в SQLite-базе. Она лежит в `recon.db`.\n\n1. Убедись, что это база: `file recon.db`\n2. Посмотри таблицы: `sqlite3 recon.db \".tables\"`\n3. Выведи контакты: `sqlite3 recon.db \"SELECT * FROM contacts;\"`\n4. У одного контакта в поле `notes` есть маркер `nto{...}`. Запиши его в `answer.txt` и набери `check`.\n"
    },
    {
      "path": "/home/student/task/recon.db",
      "b64": "",
      "mode": "644"
    }
  ],
  "tools": {
    "sqlite3": {
      "help": "sqlite3 <база> \"<SQL>\" — запрос к SQLite (эмуляция)",
      "cases": [
        {
          "match": "tables",
          "example": "sqlite3 recon.db \".tables\"",
          "output": "contacts  domains  hosts\n"
        },
        {
          "match": "contacts",
          "example": "sqlite3 recon.db \"SELECT * FROM contacts;\"",
          "output": "first_name  last_name   email                   title    notes\n----------  ----------  ----------------------  -------  -----------------------------\nIvan        Petrov      i.petrov@example.com    DevOps   nto{r3c0n_ng_gr4ph_1s_sql1t3}\nAnna        Sidorova    a.sidorova@example.com  HR       \n"
        },
        {
          "match": "hosts",
          "example": "sqlite3 recon.db \"SELECT host,ip FROM hosts;\"",
          "output": "host                 ip\n-------------------  -----------\nwww.example.com      198.18.0.17\napi.example.com      198.18.0.18\nmail.example.com     198.18.0.19\nstaging.example.com  198.18.0.20\n"
        },
        {
          "match": "domains",
          "example": "sqlite3 recon.db \"SELECT domain FROM domains;\"",
          "output": "domain\n-----------\nexample.com\n"
        }
      ],
      "fallback": "sqlite3: в этой лабе есть таблицы domains, hosts, contacts.\n"
    }
  }
}
