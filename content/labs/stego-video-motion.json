{
  "id": "stego-video-motion",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{m0t10n_v3ct0r_c0d3c}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача\n\n`video.mp4` — короткое H.264-видео. Пиксельный LSB не даёт ничего, но флаг «внутри видеокодека». Достань его.\n"
    },
    {
      "path": "/home/student/task/video.mp4",
      "b64": "",
      "mode": "644"
    },
    {
      "path": "/home/student/task/boxes.py",
      "text": "import struct\ndata = open(\"video.mp4\", \"rb\").read()\noff = 0\nwhile off + 8 <= len(data):\n    size, typ = struct.unpack(\">I4s\", data[off:off+8])\n    if size < 8: break\n    print(\"%-6s size=%d\" % (typ.decode(\"latin1\"), size))\n    off += size\nprint(\"hint: inspect the appended box\")\n"
    },
    {
      "path": "/home/student/task/mv.py",
      "text": "import struct\ndata = open(\"video.mp4\", \"rb\").read()\noff = 0\nwhile off + 8 <= len(data):\n    size, typ = struct.unpack(\">I4s\", data[off:off+8])\n    if size < 8: break\n    if typ == b\"free\":\n        print(data[off+8:off+size].decode())\n    off += size\n"
    }
  ],
  "tools": {
    "ffprobe": {
      "help": "ffprobe [-show_streams] <файл> — параметры потоков",
      "cases": [
        {
          "match": "video\\.mp4",
          "example": "ffprobe -v error -show_streams video.mp4",
          "output": "[STREAM]\nindex=0\ncodec_name=h264\nwidth=96\nheight=64\nnb_frames=3\npict_type=I\npict_type=P\npict_type=B\n[/STREAM]\n"
        }
      ]
    },
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4\n"
        },
        {
          "match": "boxes\\.py",
          "example": "python3 boxes.py",
          "output": "ftyp size=24\nmoov size=...\nfree size=32  <- appended after moov\nhint: inspect the appended box\n"
        },
        {
          "match": "mv\\.py",
          "example": "python3 mv.py",
          "output": "nto{m0t10n_v3ct0r_c0d3c}\n"
        }
      ]
    }
  }
}
