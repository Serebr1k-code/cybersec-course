{
  "id": "osint-image-reverse",
  "hostname": "lab",
  "workdir": "/home/student/task",
  "expect": {
    "file": "/home/student/task/answer.txt",
    "contains": "nto{r3v3rs3_1m4g3_s0urc3_f0und}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Практика: найди источник фото\n\nФото `street.jpg` разошлось по сети. Нужно найти первоисточник.\n\n1. Метаданные: `exiftool street.jpg` (есть GPS и дата).\n2. Точные совпадения: `curl -s -X POST \"https://api.tineye.com/rest/search/\" -F \"image=@street.jpg\" > tineye.json`\n3. `jq -r '.matches[].backlinks[] | [.crawl_date, .url] | @tsv' tineye.json`\n4. Самое старое совпадение — первоисточник. Открой его: `curl -s \"https://forum.example.org/thread/12345\" > src.html`\n5. `grep nto src.html` — запиши `nto{...}` в `answer.txt`, набери `check`.\n"
    },
    {
      "path": "/home/student/task/street.jpg",
      "b64": "",
      "mode": "644"
    }
  ],
  "tools": {
    "exiftool": {
      "help": "exiftool <файл> — метаданные (эмуляция)",
      "cases": [
        {
          "match": "street\\.jpg",
          "example": "street.jpg",
          "output": "======== street.jpg\nExifTool Version Number         : 12.76\nFile Name                       : street.jpg\nFile Type                       : JPEG\nMake                            : Apple\nCamera Model Name               : iPhone 12\nDate/Time Original              : 2019:06:01 18:22:03\nGPS Latitude                    : 55 deg 45' 20.88\" N\nGPS Longitude                   : 37 deg 37' 2.28\" E\nGPS Position                    : 55 deg 45' 20.88\" N, 37 deg 37' 2.28\" E\n    1 image files read\n"
        }
      ],
      "fallback": "exiftool: в этой лабе есть только street.jpg.\n"
    },
    "curl": {
      "help": "curl [-s] <URL> — TinEye API / страница-источник (эмуляция)",
      "cases": [
        {
          "match": "api\\.tineye\\.com",
          "example": "curl -s -X POST https://api.tineye.com/rest/search/ -F image=@street.jpg",
          "output": "{\"code\": 200, \"total_results\": 3, \"matches\": [\n {\"score\": 100.0, \"backlinks\": [\n   {\"crawl_date\": \"2019-06-02\", \"url\": \"https://forum.example.org/thread/12345\"},\n   {\"crawl_date\": \"2021-04-11\", \"url\": \"https://blog.example.net/street.html\"}]},\n {\"score\": 87.3, \"backlinks\": [\n   {\"crawl_date\": \"2022-08-30\", \"url\": \"https://mirror.example.com/photo\"}]}\n]}\n"
        },
        {
          "match": "forum\\.example\\.org",
          "example": "curl -s https://forum.example.org/thread/12345",
          "output": "<html><head><title>Summer trip 2019</title></head><body>\n<p>Original upload, geotag 55.7558,37.6173</p>\n<p>source marker: nto{r3v3rs3_1m4g3_s0urc3_f0und}</p>\n</body></html>\n"
        }
      ],
      "fallback": "curl: в этой лабе доступны api.tineye.com и forum.example.org/thread/12345.\n"
    },
    "jq": {
      "help": "jq [-r] <фильтр> <файл> — разбор JSON (эмуляция)",
      "cases": [
        {
          "match": "matches|backlinks|crawl_date",
          "example": "jq -r '.matches[].backlinks[] | [.crawl_date, .url] | @tsv' tineye.json",
          "output": "2019-06-02\thttps://forum.example.org/thread/12345\n2021-04-11\thttps://blog.example.net/street.html\n2022-08-30\thttps://mirror.example.com/photo\n"
        }
      ],
      "fallback": "jq: в этой лабе поддержан фильтр по .matches[].backlinks[].\n"
    }
  }
}
