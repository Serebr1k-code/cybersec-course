{
 "id": "forensics-gcp-forensics",
 "workdir": "/home/student/task",
 "hostname": "lab",
 "expect": {
  "file": "/home/student/task/found.txt",
  "contains": "nto{gcp_4ud1t_l0g_k3y_p3rs1st3nc3}"
 },
 "fs": [
  {
   "path": "/home/student/task",
   "type": "dir"
  },
  {
   "path": "/home/student/task/task.md",
   "text": "# Задача: расследование инцидента в GCP\n\nПодозрение на кражу данных из проекта. Есть экспорт Cloud Audit Logs `audit.json`\nи права на чтение логов. Восстанови цепочку и найди флаг.\n\nШаги:\n1. Ищи создание ключа сервисной учётки:\n   `gcloud logging read 'protoPayload.methodName:\"CreateServiceAccountKey\"' --freshness=7d`.\n2. Ищи эскалацию: `gcloud logging read 'protoPayload.methodName:\"SetIamPolicy\"' --freshness=7d`.\n3. Ищи доступ к данным: `gcloud logging read 'protoPayload.methodName:\"storage.objects.get\"' --freshness=7d`.\n4. Флаг — имя выкачанного объекта: `grep nto audit.json > found.txt`.\n"
  },
  {
   "path": "/home/student/task/notes.txt",
   "text": "Заметки:\n- Admin Activity логи включены всегда; Data Access — по умолчанию ВЫКЛЮЧЕН.\n- Персистентность: долгоживущий ключ service account не требует «входа».\n- Ищи последовательность: CreateServiceAccountKey -> SetIamPolicy -> доступ к данным.\n"
  },
  {
   "path": "/home/student/task/audit.json",
   "b64": "",
   "mode": "644"
  }
 ],
 "tools": {
  "gcloud": {
   "help": "gcloud logging read <фильтр> [--freshness=Nd] — эмуляция gcloud",
   "cases": [
    {
     "match": "CreateServiceAccountKey",
     "example": "logging read 'protoPayload.methodName:\"CreateServiceAccountKey\"'",
     "output": "TIMESTAMP                PRINCIPAL_EMAIL          REQUEST_NAME\n2024-03-01T22:10:00Z     attacker@example.com     projects/case-4412/serviceAccounts/ci-sa@case-4412.iam.gserviceaccount.com\n"
    },
    {
     "match": "SetIamPolicy",
     "example": "logging read 'protoPayload.methodName:\"SetIamPolicy\"'",
     "output": "TIMESTAMP                PRINCIPAL_EMAIL\n2024-03-01T22:12:00Z     attacker@example.com\n"
    },
    {
     "match": "storage\\.objects",
     "example": "logging read 'protoPayload.methodName:\"storage.objects.get\"'",
     "output": "TIMESTAMP                PRINCIPAL_EMAIL                      RESOURCE\n2024-03-01T22:15:00Z     ci-sa@case-4412.iam.gserviceaccount.com  projects/_/buckets/case-4412-evidence/objects/nto{gcp_4ud1t_l0g_k3y_p3rs1st3nc3}.tar.gz\n"
    },
    {
     "match": "logging\\s+read",
     "example": "logging read '<фильтр>'",
     "output": "TIMESTAMP                PRINCIPAL_EMAIL\n2024-03-01T22:15:00Z     ci-sa@case-4412.iam.gserviceaccount.com\n"
    }
   ]
  }
 }
}