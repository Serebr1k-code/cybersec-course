{
  "id": "stegoanalysis-cover-source-mismatch",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{c0v3r_s0urc3_m1sm4tch}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: детект при mismatch и извлечение\n\n`image.png` — файл из нетипичного источника. Готовая модель даёт 'CLEAN', но данные есть. Разберись и извлеки.\n\n1. `python3 detect.py` — вероятности двух моделей.\n2. `python3 extract.py` — извлечение.\n3. Запиши флаг в `found.txt`.\n"
    },
    {
      "path": "/home/student/task/image.png",
      "b64": ""
    },
    {
      "path": "/home/student/task/detect.py",
      "text": "print('model A (trained on BOSSbase):  prob_stego = 0.12  -> CLEAN')\nprint('model B (trained on source X):  prob_stego = 0.88  -> STEGO')\n"
    },
    {
      "path": "/home/student/task/extract.py",
      "text": "print('nto{c0v3r_s0urc3_m1sm4tch}')\n"
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция, вывод реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        },
        {
          "match": "detect\\.py",
          "example": "python3 detect.py",
          "output": "model A (trained on BOSSbase):  prob_stego = 0.12  -> CLEAN\nmodel B (trained on source X):  prob_stego = 0.88  -> STEGO\n"
        },
        {
          "match": "extract\\.py",
          "example": "python3 extract.py",
          "output": "nto{c0v3r_s0urc3_m1sm4tch}\n"
        }
      ]
    }
  }
}
