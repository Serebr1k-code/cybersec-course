{
 "id": "forensics-mobile-ios",
 "workdir": "/home/student/task",
 "hostname": "lab",
 "expect": {
  "file": "/home/student/task/found.txt",
  "contains": "nto{i0s_m4n1f3st_db_unl0cks_b4ckup}"
 },
 "fs": [
  {
   "path": "/home/student/task",
   "type": "dir"
  },
  {
   "path": "/home/student/task/task.md",
   "text": "# Задача: анализ iOS-бэкапа\n\nЕсть бэкап iPhone (Finder/iTunes). Нужно найти сообщение с флагом.\nФайлы в бэкапе «безымянные» — их сопоставляет `Manifest.db`.\n\nШаги:\n1. Определи, зашифрован ли бэкап: `plutil -p Info.plist` (ищи `IsEncrypted`).\n2. Прочитай карту файлов: `sqlite3 Manifest.db \"SELECT fileID, domain, relativePath FROM Files\"`.\n   Найди домен `AppDomain-com.apple.MobileSMS` -> `Library/SMS/sms.db`.\n3. Прочитай переписку: `sqlite3 sms.db \"SELECT text FROM message ORDER BY date DESC LIMIT 3\"`.\n4. Сохрани флаг: `sqlite3 sms.db \"SELECT text FROM message\" | grep nto > found.txt`.\n"
  },
  {
   "path": "/home/student/task/notes.txt",
   "text": "Заметки:\n- iOS хранит время не от Unix-эпохи (1970), а от 2001: сдвиг 978307200 с.\n- В sms.db время в наносекундах: `datetime(date/1000000000 + 978307200,'unixepoch')`.\n- fileID — SHA1 от domain+path; первые два символа = подкаталог в бэкапе.\n"
  },
  {
   "path": "/home/student/task/Info.plist",
   "b64": "",
   "mode": "644"
  },
  {
   "path": "/home/student/task/Manifest.db",
   "b64": "",
   "mode": "644"
  },
  {
   "path": "/home/student/task/sms.db",
   "b64": "",
   "mode": "644"
  }
 ],
 "tools": {
  "plutil": {
   "help": "plutil -p <файл.plist> — печать свойств plist (эмуляция)",
   "cases": [
    {
     "match": "\\-p\\s+Info\\.plist",
     "example": "-p Info.plist",
     "output": "{\n  \"BuildVersion\" => \"21E219\"\n  \"Device Name\" => \"Analyst iPhone\"\n  \"IsEncrypted\" => 1\n  \"Last Backup Date\" => \"2024-03-01T22:05:00Z\"\n  \"ProductType\" => \"iPhone14,5\"\n  \"ProductVersion\" => \"17.4\"\n  \"Serial Number\" => \"F17XK9ABCDEF\"\n}\n"
    }
   ]
  },
  "sqlite3": {
   "help": "sqlite3 <база> [SQL] — эмуляция sqlite3 (вывод захвачен из реального запуска)",
   "cases": [
    {
     "match": "Manifest.*Files",
     "example": "Manifest.db \"SELECT fileID, domain, relativePath FROM Files\"",
     "output": "a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f80910|HomeDomain|Library/Preferences/com.apple.mobiletimer.plist\nb2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8091011|AppDomain-com.apple.MobileSMS|Library/SMS/sms.db\nc3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f809101112|CameraRollDomain|Media/DCIM/100APPLE/IMG_0001.JPG\n"
    },
    {
     "match": "sms\\.db.*message",
     "example": "sms.db \"SELECT text FROM message ORDER BY date DESC LIMIT 3\"",
     "output": "nto{i0s_m4n1f3st_db_unl0cks_b4ckup}\nОк\nВстречаемся в 18:00?\n"
    }
   ]
  }
 }
}