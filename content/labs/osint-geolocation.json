{
  "id": "osint-geolocation",
  "hostname": "lab",
  "workdir": "/home/student/task",
  "expect": {
    "file": "/home/student/task/answer.txt",
    "contains": "nto{g30_by_0cr_4nd_m4p5}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Практика: где сделан снимок?\n\nФото `street.jpg` без геометки. Нужно определить место: OCR вывески + обратное геокодирование.\n\n1. Проверь метаданные: `exiftool street.jpg` (GPS отсутствует).\n2. Распознай текст на фото: `tesseract street.jpg - -l rus+eng`\n3. Подтверди место: `curl -s \"https://nominatim.openstreetmap.org/reverse?lat=55.7558&lon=37.6173&format=json\"`\n4. `jq -r '.display_name' geo.json`\n5. На вывеске/плакате есть маркер `nto{...}` — запиши в `answer.txt`, набери `check`.\n"
    },
    {
      "path": "/home/student/task/street.jpg",
      "b64": "",
      "mode": "644"
    }
  ],
  "tools": {
    "exiftool": {
      "help": "exiftool <файл> — чтение метаданных (эмуляция)",
      "cases": [
        {
          "match": "street\\.jpg",
          "example": "street.jpg",
          "output": "======== street.jpg\nExifTool Version Number         : 12.76\nFile Name                       : street.jpg\nFile Type                       : JPEG\nMake                            : Apple\nCamera Model Name               : iPhone 12\nSoftware                        : Adobe Photoshop 24.0\nDate/Time Original              : 2019:06:01 18:22:03\nImage Width                     : 800\nImage Height                    : 600\n    1 image files read\n"
        }
      ],
      "fallback": "exiftool: в этой лабе есть только street.jpg.\n"
    },
    "tesseract": {
      "help": "tesseract <файл> <вывод> [-l rus+eng] — OCR (эмуляция)",
      "cases": [
        {
          "match": "street\\.jpg",
          "example": "street.jpg - -l rus+eng",
          "output": "APTЕKA N 12\nul. Tverskaya, 12\nnto{g30_by_0cr_4nd_m4p5}\n"
        }
      ],
      "fallback": "tesseract: в этой лабе распознаётся только street.jpg.\n"
    },
    "curl": {
      "help": "curl [-s] <URL> — Nominatim reverse geocode (эмуляция)",
      "cases": [
        {
          "match": "nominatim\\.openstreetmap\\.org/reverse",
          "example": "curl -s \"https://nominatim.openstreetmap.org/reverse?lat=55.7558&lon=37.6173&format=json\"",
          "output": "{\"place_id\": 123456, \"licence\": \"ODbL\", \"lat\":\"55.7558\",\"lon\":\"37.6173\", \"display_name\": \"улица Тверская, 12, Тверской район, Москва, Россия\", \"address\":{\"road\":\"улица Тверская\",\"city\":\"Москва\",\"country\":\"Россия\"}}\n"
        }
      ],
      "fallback": "curl: в этой лабе доступен только nominatim.openstreetmap.org/reverse.\n"
    },
    "jq": {
      "help": "jq [-r] <фильтр> <файл> — разбор JSON (эмуляция)",
      "cases": [
        {
          "match": "display_name|address",
          "example": "jq -r '.display_name' geo.json",
          "output": "улица Тверская, 12, Тверской район, Москва, Россия\n"
        }
      ],
      "fallback": "jq: в этой лабе поддержан фильтр по .display_name.\n"
    }
  }
}
