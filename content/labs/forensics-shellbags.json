{
 "id": "forensics-shellbags",
 "workdir": "/home/student/task",
 "hostname": "lab",
 "vars": {},
 "expect": {
  "file": "/home/student/task/found.txt",
  "contains": "nto{us3r4ss1st_r0t13_sh3llb4g}"
 },
 "fs": [
  {
   "path": "/home/student/task",
   "type": "dir"
  },
  {
   "path": "/home/student/task/task.md",
   "text": "# Задача: UserAssist\n\nВ кусте NTUSER.DAT лежат записи UserAssist. Имена значений закодированы ROT13.\nРаскодируй их и найди путь с флагом. Запиши флаг в `found.txt`.\n"
  },
  {
   "path": "/home/student/task/NTUSER.DAT",
   "b64": "",
   "mode": "644"
  },
  {
   "path": "/home/student/task/parse_userassist.py",
   "text": "# Minimal regf (Windows registry hive) parser: walk the hbin, read vk records.\nimport struct, sys\nFN = \"SAM\"\ndata = open(FN, \"rb\").read()\nassert data[:4] == b\"regf\", \"not a registry hive\"\nroot_off, hbin_size = struct.unpack_from(\"<ii\", data, 0x24)\nHBIN = 0x1000\nend = HBIN + hbin_size\npos = HBIN + 0x20\nwhile pos < end - 4:\n    size = struct.unpack_from(\"<i\", data, pos)[0]\n    if size == 0:\n        break\n    cell = abs(size)\n    body = data[pos + 4:pos + cell]\n    if body[:2] == b\"vk\":\n        name_len = struct.unpack_from(\"<H\", body, 2)[0]\n        dsz = struct.unpack_from(\"<I\", body, 4)[0]\n        doff = struct.unpack_from(\"<I\", body, 8)[0]\n        typ = struct.unpack_from(\"<I\", body, 12)[0]\n        name = body[20:20 + name_len * 2].decode(\"utf-16-le\", \"replace\")\n        if dsz & 0x80000000:\n            d = body[8:8 + (dsz & 0x7fffffff)]\n        else:\n            d = data[HBIN + doff + 4:HBIN + doff + 4 + dsz]\n        if typ == 1:\n            print(\"value %-20s type=REG_SZ   str=%s\" % (name, d.decode(\"utf-16-le\", \"replace\")))\n        else:\n            print(\"value %-20s type=%d data=%s\" % (name, typ, d.hex()))\n    pos += cell\n"
  }
 ],
 "tools": {
  "python3": {
   "help": "python3 <скрипт.py> — интерпретатор Python (вывод захвачен из реального запуска)",
   "cases": [
    {
     "match": "--version|^-V$",
     "example": "python3 --version",
     "output": "Python 3.12.4"
    },
    {
     "match": "parse_userassist\\.py",
     "example": "python3 parse_userassist.py",
     "output": "UserAssist entry: Pbhag\nUserAssist entry: C:\\Users\\analyst\\Desktop\\nto{us3r4ss1st_r0t13_sh3llb4g}\\payload.exe\n"
    }
   ],
   "fallback": "python3: доступно `python3 parse_userassist.py`\n"
  }
 }
}