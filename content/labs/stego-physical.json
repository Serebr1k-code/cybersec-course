      "path": "/home/student/task/relief.py",
      "text": "import re\nfrom PIL import Image\nimg = Image.open('paper.png').convert('L')\npx = img.load()\nbits = ''\nfor i in range(240):\n    gx = 3 + (i % 20) * 5\n    gy = 3 + (i // 20) * 5\n    bits += '1' if px[gx, gy] < 128 else '0'\ndata = bytes(int(bits[i:i+8], 2) for i in range(0, len(bits)//8*8, 8))\nm = re.search(rb'nto\\{[^}]*\\}', data)\nprint('micro-perforation grid (dark = 1):')\nprint(m.group().decode() if m else '(nothing)')\n"
