{
  "id": "osint-github-recon",
  "hostname": "lab",
  "workdir": "/home/student/task",
  "expect": {
    "file": "/home/student/task/answer.txt",
    "contains": "nto{gh_c0d3_s34rch_f1nds_s3cr3ts}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Практика: утечки в публичных репозиториях GitHub\n\nОрганизация `example` на GitHub. Нужно найти утёкший секрет в её\nпубличных репозиториях.\n\n1. Профиль организации: curl -s https://api.github.com/orgs/example\n2. Поиск по коду: curl -s 'https://api.github.com/search/code?q=org:example+AKIA'\n3. Среди результатов — файл с ключом AWS и флагом.\n4. Достань строку nto{...} и запиши её в answer.txt, затем набери check.\n"
    }
  ],
  "tools": {
    "curl": {
      "help": "curl [-s] <url> — HTTP-клиент (эмуляция GitHub API)",
      "cases": [
        {
          "match": "search/code",
          "example": "-s 'https://api.github.com/search/code?q=org:example+AKIA'",
          "output": "{\n  \"total_count\": 1,\n  \"incomplete_results\": false,\n  \"items\": [\n    {\n      \"name\": \"deploy.py\",\n      \"path\": \"scripts/deploy.py\",\n      \"repository\": { \"full_name\": \"example/infra\", \"private\": false },\n      \"html_url\": \"https://github.com/example/infra/blob/main/scripts/deploy.py\",\n      \"text_matches\": [\n        { \"fragment\": \"AWS_ACCESS_KEY_ID = \\\"AKIAIOSFODNN7EXAMPLE\\\"\\n# nto{gh_c0d3_s34rch_f1nds_s3cr3ts}\\n\" }\n      ]\n    }\n  ]\n}\n"
        },
        {
          "match": "search/repositories",
          "example": "-s 'https://api.github.com/search/repositories?q=org:example'",
          "output": "{\n  \"total_count\": 3,\n  \"items\": [\n    { \"full_name\": \"example/infra\", \"description\": \"Terraform + deploy scripts\", \"stargazers_count\": 12 },\n    { \"full_name\": \"example/web\", \"description\": \"Public site\", \"stargazers_count\": 41 },\n    { \"full_name\": \"example/docs\", \"description\": \"Documentation\", \"stargazers_count\": 3 }\n  ]\n}\n"
        },
        {
          "match": "orgs/example",
          "example": "-s https://api.github.com/orgs/example",
          "output": "{\n  \"login\": \"example\",\n  \"id\": 12345678,\n  \"name\": \"Example Corp\",\n  \"blog\": \"https://example.com\",\n  \"location\": \"Amsterdam, NL\",\n  \"public_repos\": 3,\n  \"created_at\": \"2014-03-01T00:00:00Z\"\n}\n"
        }
      ],
      "fallback": "curl: в этой лабе эмулируется api.github.com.\n"
    }
  }
}
