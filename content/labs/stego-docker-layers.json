{
  "id": "stego-docker-layers",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{docker_layer_extra_file}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: лишний файл в слое Docker\n\n`layer.tar.gz` — слой образа (tar.gz). В нём есть файл, не нужный\nприложению.\n\n1. `tar tzf layer.tar.gz`.\n2. `python3 dlayer.py` — чтение файла.\n3. `python3 dlayer.py | grep nto > found.txt`.\n"
    },
    {
      "path": "/home/student/task/layer.tar.gz",
      "b64": ""
    },
    {
      "path": "/home/student/task/dlayer.py",
      "text": "import tarfile\nt = tarfile.open('layer.tar.gz', 'r:gz')\nfor m in t.getmembers():\n    if m.name.endswith('secret'):\n        print(t.extractfile(m).read().decode())\n"
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция, вывод реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        },
        {
          "match": "dlayer\\.py",
          "example": "python3 dlayer.py",
          "output": "nto{docker_layer_extra_file}\n"
        }
      ]
    }
  }
}
