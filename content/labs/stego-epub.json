{
  "id": "stego-epub",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{epub_unreferenced_file}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: необъявленный файл в EPUB\n\n`book.epub` — ZIP-архив. Один файл не упомянут в OPF-манифесте.\n\n1. `unzip -l book.epub`.\n2. `python3 epub.py` — чтение скрытого файла.\n3. `python3 epub.py | grep nto > found.txt`.\n"
    },
    {
      "path": "/home/student/task/book.epub",
      "b64": ""
    },
    {
      "path": "/home/student/task/epub.py",
      "text": "import zipfile\nz = zipfile.ZipFile('book.epub')\nopf = z.read('OEBPS/content.opf').decode()\nfor name in z.namelist():\n    if name.endswith('secret.txt'):\n        print(z.read(name).decode())\n"
    }
  ],
  "tools": {
    "python3": {
      "help": "python3 <скрипт.py> — интерпретатор Python (эмуляция, вывод реального запуска)",
      "cases": [
        {
          "match": "--version|^-V$",
          "example": "python3 --version",
          "output": "Python 3.12.4"
        },
        {
          "match": "epub\\.py",
          "example": "python3 epub.py",
          "output": "nto{epub_unreferenced_file}\n"
        }
      ]
    }
  }
}
