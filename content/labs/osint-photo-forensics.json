{
  "id": "osint-photo-forensics",
  "hostname": "lab",
  "workdir": "/home/student/task",
  "expect": {
    "file": "/home/student/task/answer.txt",
    "contains": "nto{3l4_m4n1pul4t10n_d3t3ct3d}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Практика: подлинное фото или монтаж?\n\nВ соцсетях разошлось фото «с митинга» (`protest.jpg`). Нужно технически доказать, что его редактировали, и достать спрятанную заметку.\n\n1. Прочитай метаданные: `exiftool protest.jpg`\n2. Посмотри полный дамп с группами: `exiftool -a -u -g1 protest.jpg`\n3. Найди расхождение дат съёмки/изменения и поле `Software`.\n4. Проверь сырые байты: `strings protest.jpg | grep nto`\n5. Запиши строку `nto{...}` в `answer.txt` и набери `check`.\n"
    },
    {
      "path": "/home/student/task/protest.jpg",
      "b64": "",
      "mode": "644"
    }
  ],
  "tools": {
    "exiftool": {
      "help": "exiftool [-a -u -g1] <файл…> — чтение метаданных (эмуляция)",
      "cases": [
        {
          "match": "protest\\.jpg",
          "example": "protest.jpg",
          "output": "======== protest.jpg\nExifTool Version Number         : 12.76\nFile Name                       : protest.jpg\nFile Size                       : 8.4 kB\nFile Type                       : JPEG\nMIME Type                       : image/jpeg\nMake                            : Apple\nCamera Model Name               : iPhone 12\nSoftware                        : Adobe Photoshop 24.0\nModify Date                     : 2024:03:11 22:41:55\nDate/Time Original              : 2024:03:11 09:14:02\nUser Comment                    : nto{3l4_m4n1pul4t10n_d3t3ct3d}\nImage Width                     : 512\nImage Height                    : 512\n    1 image files read\n"
        }
      ],
      "fallback": "exiftool: в этой лабе есть только protest.jpg.\n"
    }
  }
}
