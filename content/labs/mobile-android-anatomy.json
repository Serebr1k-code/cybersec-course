{
  "id": "mobile-android-anatomy",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{4pk_4n4t0my}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: анатомия APK\n\n`app.apk` — Android-приложение. Разбери его структуру и найди строковый\nресурс с флагом.\n\n`unzip` умеет `-l` (список) и `-p` (напечатать файл из архива).\n"
    },
    {
      "path": "/home/student/task/app.apk",
      "b64": ""
    }
  ],
  "tools": {
    "unzip": {
      "help": "unzip [-l | -p <файл>] <архив> — список/извлечение (эмуляция, вывод захвачен с реального unzip)",
      "cases": [
        {
          "match": "-l\\s+app\\.apk",
          "example": "-l app.apk",
          "output": "Archive:  app.apk\n  Length      Date    Time    Name\n---------  ---------- -----   ----\n      495  2026-10-13 11:50   AndroidManifest.xml\n      103  2026-10-13 11:50   classes.dex\n       36  2026-10-13 11:50   resources.arsc\n      214  2026-10-13 11:50   res/values/strings.xml\n       52  2026-10-13 11:50   lib/arm64-v8a/libnative.so\n       68  2026-10-13 11:50   META-INF/CERT.RSA\n---------                     -------\n      968                     6 files\n"
        },
        {
          "match": "-p\\s+app\\.apk\\s+res/values/strings\\.xml",
          "example": "-p app.apk res/values/strings.xml",
          "output": "<?xml version=\"1.0\"?>\n<resources>\n  <string name=\"app_name\">Vanta Lab</string>\n  <string name=\"flag\">nto{4pk_4n4t0my}</string>\n  <string name=\"api_key\">AIzaSyDECOY0000000000000000000000000000</string>\n</resources>\n"
        }
      ]
    }
  }
}
