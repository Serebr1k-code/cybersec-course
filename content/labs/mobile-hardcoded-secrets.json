{
  "id": "mobile-hardcoded-secrets",
  "workdir": "/home/student/task",
  "hostname": "lab",
  "expect": {
    "file": "/home/student/task/found.txt",
    "contains": "nto{b4s364_1n_4pk}"
  },
  "fs": [
    {
      "path": "/home/student/task",
      "type": "dir"
    },
    {
      "path": "/home/student/task/task.md",
      "text": "# Задача: секрет в ассетах\n\nВ APK (`app.apk`) спрятан файл в `assets/`. Внутри — base64-значение.\nДостань его и раскодируй; флаг запиши в `found.txt`.\n\n`unzip` в этой лабе умеет только `-l` (список) и `-p` (печать файла).\n"
    },
    {
      "path": "/home/student/task/app.apk",
      "b64": ""
    }
  ],
  "tools": {
    "unzip": {
      "help": "unzip [-l | -p <файл>] <архив> — список/извлечение (эмуляция, вывод захвачен с реального unzip)",
      "cases": [
        {
          "match": "-l\\s+app\\.apk",
          "example": "-l app.apk",
          "output": "Archive:  app.apk\n  Length      Date    Time    Name\n---------  ---------- -----   ----\n      495  2026-10-13 11:50   AndroidManifest.xml\n      103  2026-10-13 11:50   classes.dex\n       36  2026-10-13 11:50   resources.arsc\n      214  2026-10-13 11:50   res/values/strings.xml\n       52  2026-10-13 11:50   lib/arm64-v8a/libnative.so\n       68  2026-10-13 11:50   META-INF/CERT.RSA\n       31  2026-10-13 11:50   assets/config.dat\n---------                     -------\n      999                     7 files\n"
        },
        {
          "match": "-p\\s+app\\.apk\\s+assets/config\\.dat",
          "example": "-p app.apk assets/config.dat",
          "output": "v1|bnRve2I0czM2NF8xbl80cGt9|eof"
        }
      ]
    }
  }
}
